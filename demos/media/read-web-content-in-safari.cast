{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Read and navigate web content in Safari, including off-screen elements", "version": 2, "width": 80}
[1.0, "m", "Open idb's documentation in Safari"]
[1.0, "o", "$ idb open https://fbidb.io/docs/idb/fbsimulatorcontrol\r\n"]
[1.436, "o", "[exited 0 after 0.44s]\r\n"]
[7.133, "m", "Find a single heading in the page's accessibility tree"]
[7.133, "o", "$ idb ui describe-all --api axbridge --format complete --match 'Functionality beyond Apple' --key AXLabel --key AXFrame --json\r\n"]
[8.55, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[{\"children\":[],\"frame\":{\"height\":60,\"width\":325,\"x\":16,\"y\":7832},\"label\":\"Functionality beyond Apple's tools\"},{\"children\":[],\"frame\":{\"height\":30,\"width\":24,\"x\":71,\"y\":7862},\"label\":\"Direct link to Functionality beyond Apple's tools\"}],\"frame\":{\"height\":61,\"width\":370,\"x\":16,\"y\":7832},\"label\":\"Functionality beyond Apple's tools Direct link to Functionality beyond Apple's tools\"}],\"frames\":{\"framed\":3,\"total\":3,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"Functionality beyond Apple\",\"match_key\":\"AXLabel\",\"matched\":3,\"walked\":1413},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 1.42s]\r\n"]
[9.918, "m", "Tap the address bar by accessibility identifier"]
[9.918, "o", "$ idb ui tap TabBarItemTitle --match-key AXUniqueId\r\n"]
[11.117, "o", "[exited 0 after 1.20s]\r\n"]
[12.279, "m", "Type the address of a second page"]
[12.279, "o", "$ idb ui text https://fbidb.io/docs/idb/accessibility\r\n"]
[13.855, "o", "[exited 0 after 1.58s]\r\n"]
[14.274, "m", "Read the address bar's value back"]
[14.274, "o", "$ idb ui describe URL --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[14.541, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":48,\"width\":222,\"x\":46,\"y\":792},\"help\":null,\"identifier\":\"URL\",\"label\":\"Address\",\"pid\":5026,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"TextEntry\",\"IsEditing\",\"Scrollable\",\"TextOperationsAvailable\"],\"type\":\"TextField\",\"value\":\"https:\\/\\/fbidb.io\\/docs\\/idb\\/accessibility\"}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"URL\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.27s]\r\n"]
[14.542, "m", "Submit the address with a key press"]
[14.542, "o", "$ idb ui key 40\r\n"]
[14.945, "o", "[exited 0 after 0.40s]\r\n"]
[18.154, "m", "Find SimulatorFrameworkBridge on the page that loaded"]
[18.154, "o", "$ idb ui describe-all --api axbridge --format complete --match SimulatorFrameworkBridge --key AXLabel --key AXFrame --json\r\n"]
[19.615, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"frame\":{\"height\":19,\"width\":209,\"x\":155,\"y\":3850},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":209,\"x\":31,\"y\":5291},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":210,\"x\":94,\"y\":8107},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":798,\"x\":32,\"y\":8321},\"label\":\"The SimulatorFrameworkBridge guest binary was not found in the companion Resources directory\"},{\"children\":[{\"children\":[],\"frame\":{\"height\":19,\"width\":209,\"x\":50,\"y\":29213},\"label\":\"SimulatorFrameworkBridge\"}],\"frame\":{\"height\":557,\"width\":338,\"x\":48,\"y\":29155},\"label\":\".axBridge is --api axbridge: the in-guest reader, through theSimulatorFrameworkBridge helper thatFBSimulatorServices runs inside the booted Simulator. Its persistence chooses which guest serves the read:\"}],\"frames\":{\"framed\":6,\"total\":6,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"SimulatorFrameworkBridge\",\"match_key\":\"AXLabel\",\"matched\":6,\"walked\":2054},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 1.46s]\r\n"]
