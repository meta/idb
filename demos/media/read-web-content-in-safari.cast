{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Read and navigate web content in Safari, including off-screen elements", "version": 2, "width": 80}
[1.0, "m", "Open idb's documentation in Safari"]
[1.0, "o", "$ idb open https://fbidb.io/docs/idb/fbsimulatorcontrol\r\n"]
[1.7, "o", "[exited 0 after 0.70s]\r\n"]
[7.163, "m", "Find a single heading in the page's accessibility tree"]
[7.163, "o", "$ idb ui describe-all --api axbridge --format complete --match 'Functionality beyond Apple' --key AXLabel --key AXFrame --json\r\n"]
[8.395, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[{\"children\":[],\"frame\":{\"height\":60,\"width\":325,\"x\":16,\"y\":7832},\"label\":\"Functionality beyond Apple's tools\"},{\"children\":[],\"frame\":{\"height\":30,\"width\":24,\"x\":71,\"y\":7862},\"label\":\"Direct link to Functionality beyond Apple's tools\"}],\"frame\":{\"height\":61,\"width\":370,\"x\":16,\"y\":7832},\"label\":\"Functionality beyond Apple's tools Direct link to Functionality beyond Apple's tools\"}],\"frames\":{\"framed\":3,\"total\":3,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"Functionality beyond Apple\",\"match_key\":\"AXLabel\",\"matched\":3,\"walked\":1405},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 1.23s]\r\n"]
[9.667, "m", "Tap the address bar by accessibility identifier"]
[9.667, "o", "$ idb ui tap TabBarItemTitle --match-key AXUniqueId\r\n"]
[12.067, "o", "[exited 0 after 2.40s]\r\n"]
[12.667, "m", "Type the address of a second page"]
[12.667, "o", "$ idb ui text https://fbidb.io/docs/idb/accessibility\r\n"]
[14.073, "o", "[exited 0 after 1.41s]\r\n"]
[14.415, "m", "Read the address bar's value back"]
[14.415, "o", "$ idb ui describe URL --match-key AXUniqueId --api axbridge --format complete --json\r\n"]
[14.709, "o", "{\"automation\":null,\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"content_required\":false,\"custom_actions\":[],\"enabled\":null,\"frame\":{\"height\":48,\"width\":222,\"x\":46,\"y\":792},\"help\":null,\"identifier\":\"URL\",\"label\":\"Address\",\"pid\":6356,\"role_description\":null,\"subrole\":null,\"title\":null,\"traits\":[\"TextEntry\",\"IsEditing\",\"Scrollable\",\"TextOperationsAvailable\"],\"type\":\"TextField\",\"value\":\"https:\\/\\/fbidb.io\\/docs\\/idb\\/accessibility\"}],\"frames\":{\"framed\":1,\"total\":1,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":null,\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"marker\",\"match_key\":\"AXUniqueId\",\"pid\":null,\"value\":\"URL\",\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 0.29s]\r\n"]
[14.721, "m", "Submit the address with a key press"]
[14.721, "o", "$ idb ui key 40\r\n"]
[15.431, "o", "[exited 0 after 0.71s]\r\n"]
[20.388, "m", "Find SimulatorFrameworkBridge on the page that loaded"]
[20.388, "o", "$ idb ui describe-all --api axbridge --format complete --match SimulatorFrameworkBridge --key AXLabel --key AXFrame --json\r\n"]
[21.926, "o", "{\"automation\":{\"asserted\":false,\"enabled\":true},\"backend\":\"axbridge-exclusive\",\"coverage\":null,\"elements\":[{\"children\":[],\"frame\":{\"height\":9,\"width\":78,\"x\":279,\"y\":2442},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":209,\"x\":155,\"y\":4336},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":209,\"x\":31,\"y\":5777},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":9,\"width\":100,\"x\":164,\"y\":6704},\"label\":\"SimulatorFrameworkBridge (guest)\"},{\"children\":[],\"frame\":{\"height\":8,\"width\":100,\"x\":164,\"y\":6534},\"label\":\"SimulatorFrameworkBridge (guest)\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":210,\"x\":94,\"y\":8805},\"label\":\"SimulatorFrameworkBridge\"},{\"children\":[],\"frame\":{\"height\":19,\"width\":798,\"x\":32,\"y\":9019},\"label\":\"The SimulatorFrameworkBridge guest binary was not found in the companion Resources directory\"},{\"children\":[{\"children\":[],\"frame\":{\"height\":19,\"width\":209,\"x\":50,\"y\":29911},\"label\":\"SimulatorFrameworkBridge\"}],\"frame\":{\"height\":557,\"width\":338,\"x\":48,\"y\":29853},\"label\":\".axBridge is --api axbridge: the in-guest reader, through theSimulatorFrameworkBridge helper thatFBSimulatorServices runs inside the booted Simulator. Its persistence chooses which guest serves the read:\"}],\"frames\":{\"framed\":9,\"total\":9,\"zero_frame\":0},\"interaction\":null,\"modal\":null,\"narrowing\":{\"filter\":\"all\",\"ignore_case\":false,\"match\":\"SimulatorFrameworkBridge\",\"match_key\":\"AXLabel\",\"matched\":9,\"walked\":2140},\"profile\":null,\"screen\":{\"coordinate_space\":\"screen\",\"height\":874,\"width\":402},\"target\":{\"kind\":\"frontmost\",\"match_key\":null,\"pid\":null,\"value\":null,\"x\":null,\"y\":null},\"truncated\":false}\r\n[exited 0 after 1.54s]\r\n"]
