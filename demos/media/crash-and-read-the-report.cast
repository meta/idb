{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Crash an app on purpose and read its crash report", "version": 2, "width": 80}
[0.508, "m", "Schedule a crash with injected Swift"]
[0.508, "o", "$ idb-repl app --new-session 'import Foundation\r\nDispatchQueue.main.asyncAfter(deadline: .now() + 1) {\r\n  fatalError(\"Crashed on purpose by Swift that idb-repl injected\")\r\n}\r\nreturn \"ReplHost will crash in a second\"\r\n'\r\n"]
[2.869, "o", "Result:\r\nReplHost will crash in a second\r\nidb-repl: received generated interface(s):\r\n  IDBAPI\r\nidb-repl: compiling injected code for arm64-apple-ios26.5-simulator\r\n[exited 0 after 2.36s]\r\n"]
[25.831, "m", "List the app's crash reports"]
[25.831, "o", "$ idb crash list --bundle-id com.facebook.idb.replhost\r\n"]
[26.172, "o", "{\"name\": \"ReplHost-2026-11-06-143620.ips\", \"bundle_id\": \"com.facebook.idb.replhost\", \"process_name\": \"ReplHost\", \"parent_process_name\": \"launchd_sim\", \"process_identifier\": 12222, \"parent_process_identifier\": 1275, \"timestamp\": 1793975759}\r\n[exited 0 after 0.34s]\r\n"]
[26.177, "m", "Read the crash report"]
[26.177, "o", "$ idb crash show ReplHost-2026-11-06-143620.ips\r\n"]
