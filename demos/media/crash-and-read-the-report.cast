{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Crash an app on purpose and read its crash report", "version": 2, "width": 80}
[0.559, "m", "Schedule a crash with injected Swift"]
[0.559, "o", "$ idb-repl app --new-session 'import Foundation\r\nDispatchQueue.main.asyncAfter(deadline: .now() + 1) {\r\n  fatalError(\"Crashed on purpose by Swift that idb-repl injected\")\r\n}\r\nreturn \"ReplHost will crash in a second\"\r\n'\r\n"]
[4.287, "o", "Result:\r\nReplHost will crash in a second\r\nidb-repl: received generated interface(s):\r\n  IDBAPI\r\nidb-repl: compiling injected code for arm64-apple-ios26.5-simulator\r\n[exited 0 after 3.73s]\r\n"]
[32.464, "m", "List the app's crash reports"]
[32.464, "o", "$ idb crash list --bundle-id com.facebook.idb.replhost\r\n"]
[32.706, "o", "{\"name\": \"ReplHost-2026-11-05-182414.ips\", \"bundle_id\": \"com.facebook.idb.replhost\", \"process_name\": \"ReplHost\", \"parent_process_name\": \"launchd_sim\", \"process_identifier\": 11780, \"parent_process_identifier\": 1275, \"timestamp\": 1793903028}\r\n[exited 0 after 0.24s]\r\n"]
[32.712, "m", "Read the crash report"]
[32.712, "o", "$ idb crash show ReplHost-2026-11-05-182414.ips\r\n"]
