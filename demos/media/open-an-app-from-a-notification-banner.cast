{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.277, "o", "[exited 0 after 0.28s]\r\n"]
[1.277, "m", "Go to the home screen"]
[1.277, "o", "$ idb ui button HOME\r\n"]
[1.48, "o", "[exited 0 after 0.20s]\r\n"]
[1.712, "m", "Check what is where the banner will appear"]
[1.712, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.143, "o", "{\"role\":\"AXGroup\",\"subrole\":null,\"frame\":{\"x\":0,\"y\":0,\"width\":402,\"height\":874},\"traits\":[\"Scrollable\"],\"AXValue\":null,\"type\":\"Group\",\"content_required\":false,\"role_description\":\"Group\",\"AXUniqueId\":null,\"help\":null,\"title\":null,\"pid\":1296,\"AXLabel\":null,\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"custom_actions\":[]}\r\n[exited 0 after 0.43s]\r\n"]
[2.143, "m", "Deliver a notification while the app is not running"]
[2.143, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.445, "o", "[exited 0 after 0.30s]\r\n"]
[3.449, "m", "Tap the banner"]
[3.449, "o", "$ idb ui tap 201 90\r\n"]
[3.728, "o", "[exited 0 after 0.28s]\r\n"]
[4.951, "m", "Clear the app's delivered notifications"]
[4.951, "o", "$ idb notification clear com.apple.news\r\n"]
[5.463, "o", "[exited 0 after 0.51s]\r\n"]
[5.976, "m", "List notifications after clearing them"]
[5.976, "o", "$ idb notification list com.apple.news\r\n"]
[6.456, "o", "[exited 0 after 0.48s]\r\n"]
[8.233, "o", ""]
