{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.258, "o", "[exited 0 after 0.26s]\r\n"]
[1.258, "m", "Go to the home screen"]
[1.258, "o", "$ idb ui button HOME\r\n"]
[1.45, "o", "[exited 0 after 0.19s]\r\n"]
[1.658, "m", "Check what is where the banner will appear"]
[1.658, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.065, "o", "{\"AXLabel\":null,\"title\":null,\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"content_required\":false,\"enabled\":true,\"traits\":[\"Scrollable\"],\"pid\":2540,\"help\":null,\"custom_actions\":[],\"subrole\":null,\"role\":\"AXGroup\",\"role_description\":\"Group\",\"type\":\"Group\",\"frame\":{\"x\":0,\"width\":402.00000000000006,\"height\":874,\"y\":0},\"AXValue\":null}\r\n[exited 0 after 0.41s]\r\n"]
[2.065, "m", "Deliver a notification while the app is not running"]
[2.065, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.296, "o", "[exited 0 after 0.23s]\r\n"]
[3.299, "m", "Tap the banner"]
[3.299, "o", "$ idb ui tap 201 90\r\n"]
[3.569, "o", "[exited 0 after 0.27s]\r\n"]
[4.327, "m", "Clear the app's delivered notifications"]
[4.327, "o", "$ idb notification clear com.apple.news\r\n"]
[4.781, "o", "[exited 0 after 0.45s]\r\n"]
[5.291, "m", "List notifications after clearing them"]
[5.291, "o", "$ idb notification list com.apple.news\r\n"]
[5.71, "o", "[exited 0 after 0.42s]\r\n"]
[7.128, "o", ""]
