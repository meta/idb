{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.252, "o", "[exited 0 after 0.25s]\r\n"]
[1.253, "m", "Go to the home screen"]
[1.253, "o", "$ idb ui button HOME\r\n"]
[1.444, "o", "[exited 0 after 0.19s]\r\n"]
[1.687, "m", "Check what is where the banner will appear"]
[1.687, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.224, "o", "{\"type\":\"Group\",\"content_required\":false,\"help\":null,\"AXUniqueId\":null,\"role_description\":\"Group\",\"subrole\":null,\"title\":null,\"enabled\":true,\"AXLabel\":null,\"pid\":3726,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":402.00000000000006},\"role\":\"AXGroup\",\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"AXValue\":null}\r\n[exited 0 after 0.54s]\r\n"]
[2.224, "m", "Deliver a notification while the app is not running"]
[2.224, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.468, "o", "[exited 0 after 0.24s]\r\n"]
[3.47, "m", "Tap the banner"]
[3.47, "o", "$ idb ui tap 201 90\r\n"]
[3.736, "o", "[exited 0 after 0.27s]\r\n"]
[4.622, "m", "Clear the app's delivered notifications"]
[4.622, "o", "$ idb notification clear com.apple.news\r\n"]
[5.115, "o", "[exited 0 after 0.49s]\r\n"]
[5.764, "m", "List notifications after clearing them"]
[5.764, "o", "$ idb notification list com.apple.news\r\n"]
[6.298, "o", "[exited 0 after 0.53s]\r\n"]
[7.972, "o", ""]
