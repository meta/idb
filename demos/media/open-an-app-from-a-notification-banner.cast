{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.211, "o", "[exited 0 after 0.21s]\r\n"]
[1.211, "m", "Go to the home screen"]
[1.211, "o", "$ idb ui button HOME\r\n"]
[1.475, "o", "[exited 0 after 0.26s]\r\n"]
[1.73, "m", "Check what is where the banner will appear"]
[1.73, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.111, "o", "{\"type\":\"Group\",\"pid\":1325,\"role_description\":\"Group\",\"AXValue\":null,\"role\":\"AXGroup\",\"custom_actions\":[],\"AXUniqueId\":null,\"frame\":{\"y\":0,\"width\":401.99999999999994,\"height\":874,\"x\":0},\"subrole\":null,\"content_required\":false,\"traits\":[\"Scrollable\"],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"title\":null,\"AXLabel\":null,\"help\":null,\"enabled\":true}\r\n[exited 0 after 0.38s]\r\n"]
[2.111, "m", "Deliver a notification while the app is not running"]
[2.111, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.338, "o", "[exited 0 after 0.23s]\r\n"]
[3.343, "m", "Tap the banner"]
[3.343, "o", "$ idb ui tap 201 90\r\n"]
[3.7, "o", "[exited 0 after 0.36s]\r\n"]
[4.569, "m", "Clear the app's delivered notifications"]
[4.569, "o", "$ idb notification clear com.apple.news\r\n"]
[5.173, "o", "[exited 0 after 0.60s]\r\n"]
[5.83, "m", "List notifications after clearing them"]
[5.83, "o", "$ idb notification list com.apple.news\r\n"]
[6.414, "o", "[exited 0 after 0.58s]\r\n"]
[7.91, "o", ""]
