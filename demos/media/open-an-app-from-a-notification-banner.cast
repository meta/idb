{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.263, "o", "[exited 0 after 0.26s]\r\n"]
[1.263, "m", "Go to the home screen"]
[1.263, "o", "$ idb ui button HOME\r\n"]
[1.474, "o", "[exited 0 after 0.21s]\r\n"]
[2.35, "m", "Check what is where the banner will appear"]
[2.35, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.706, "o", "{\"content_required\":false,\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"role\":\"AXGroup\",\"title\":null,\"subrole\":null,\"enabled\":true,\"AXValue\":null,\"custom_actions\":[],\"frame\":{\"x\":0,\"height\":874,\"y\":0,\"width\":402},\"role_description\":\"Group\",\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"AXLabel\":null,\"type\":\"Group\",\"pid\":1726}\r\n[exited 0 after 0.36s]\r\n"]
[2.708, "m", "Deliver a notification while the app is not running"]
[2.708, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[3.066, "o", "[exited 0 after 0.36s]\r\n"]
[4.071, "m", "Tap the banner"]
[4.071, "o", "$ idb ui tap 201 90\r\n"]
[4.289, "o", "[exited 0 after 0.22s]\r\n"]
[5.117, "m", "Clear the app's delivered notifications"]
[5.117, "o", "$ idb notification clear com.apple.news\r\n"]
[5.641, "o", "[exited 0 after 0.52s]\r\n"]
[6.182, "m", "List notifications after clearing them"]
[6.182, "o", "$ idb notification list com.apple.news\r\n"]
[6.687, "o", "[exited 0 after 0.50s]\r\n"]
[8.148, "o", ""]
