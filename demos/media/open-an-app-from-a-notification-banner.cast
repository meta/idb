{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.235, "o", "[exited 0 after 0.24s]\r\n"]
[1.236, "m", "Go to the home screen"]
[1.236, "o", "$ idb ui button HOME\r\n"]
[1.44, "o", "[exited 0 after 0.20s]\r\n"]
[1.685, "m", "Check what is where the banner will appear"]
[1.685, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.23, "o", "{\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"help\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"enabled\":true,\"frame\":{\"x\":0,\"width\":401.99999999999994,\"height\":874,\"y\":0},\"AXLabel\":null,\"content_required\":false,\"AXValue\":null,\"AXUniqueId\":null,\"pid\":1556,\"role_description\":\"Group\",\"type\":\"Group\",\"title\":null,\"subrole\":null,\"custom_actions\":[]}\r\n[exited 0 after 0.54s]\r\n"]
[2.23, "m", "Deliver a notification while the app is not running"]
[2.23, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.566, "o", "[exited 0 after 0.34s]\r\n"]
[3.568, "m", "Tap the banner"]
[3.568, "o", "$ idb ui tap 201 90\r\n"]
[3.94, "o", "[exited 0 after 0.37s]\r\n"]
[5.517, "m", "Clear the app's delivered notifications"]
[5.517, "o", "$ idb notification clear com.apple.news\r\n"]
[6.274, "o", "[exited 0 after 0.76s]\r\n"]
[6.775, "m", "List notifications after clearing them"]
[6.775, "o", "$ idb notification list com.apple.news\r\n"]
[7.515, "o", "[exited 0 after 0.74s]\r\n"]
[9.04, "o", ""]
