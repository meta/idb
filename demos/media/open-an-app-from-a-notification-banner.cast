{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.229, "o", "[exited 0 after 0.23s]\r\n"]
[1.229, "m", "Go to the home screen"]
[1.229, "o", "$ idb ui button HOME\r\n"]
[1.409, "o", "[exited 0 after 0.18s]\r\n"]
[1.622, "m", "Check what is where the banner will appear"]
[1.622, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.08, "o", "{\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"pid\":1281,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"content_required\":false,\"help\":null,\"AXUniqueId\":null,\"role\":\"AXGroup\",\"role_description\":\"Group\",\"AXLabel\":null,\"type\":\"Group\",\"enabled\":true,\"subrole\":null,\"frame\":{\"width\":401.99999999999994,\"y\":0,\"height\":874,\"x\":0},\"AXValue\":null,\"title\":null}\r\n[exited 0 after 0.46s]\r\n"]
[2.08, "m", "Deliver a notification while the app is not running"]
[2.08, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.33, "o", "[exited 0 after 0.25s]\r\n"]
[3.332, "m", "Tap the banner"]
[3.332, "o", "$ idb ui tap 201 90\r\n"]
[3.575, "o", "[exited 0 after 0.24s]\r\n"]
[4.282, "m", "Clear the app's delivered notifications"]
[4.282, "o", "$ idb notification clear com.apple.news\r\n"]
[4.723, "o", "[exited 0 after 0.44s]\r\n"]
[5.22, "m", "List notifications after clearing them"]
[5.22, "o", "$ idb notification list com.apple.news\r\n"]
[5.721, "o", "[exited 0 after 0.50s]\r\n"]
[7.187, "o", ""]
