{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.314, "o", "[exited 0 after 0.31s]\r\n"]
[1.315, "m", "Go to the home screen"]
[1.315, "o", "$ idb ui button HOME\r\n"]
[1.544, "o", "[exited 0 after 0.23s]\r\n"]
[1.812, "m", "Check what is where the banner will appear"]
[1.812, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.32, "o", "{\"content_required\":false,\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"role\":\"AXGroup\",\"frame\":{\"y\":0,\"width\":401.99999999999994,\"height\":874,\"x\":0},\"type\":\"Group\",\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXLabel\":null,\"subrole\":null,\"custom_actions\":[],\"title\":null,\"role_description\":\"Group\",\"pid\":1310,\"help\":null,\"enabled\":true}\r\n[exited 0 after 0.51s]\r\n"]
[2.32, "m", "Deliver a notification while the app is not running"]
[2.32, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.657, "o", "[exited 0 after 0.34s]\r\n"]
[3.661, "m", "Tap the banner"]
[3.661, "o", "$ idb ui tap 201 90\r\n"]
[4.081, "o", "[exited 0 after 0.42s]\r\n"]
[5.731, "m", "Clear the app's delivered notifications"]
[5.731, "o", "$ idb notification clear com.apple.news\r\n"]
[6.406, "o", "[exited 0 after 0.68s]\r\n"]
[7.257, "m", "List notifications after clearing them"]
[7.257, "o", "$ idb notification list com.apple.news\r\n"]
[8.435, "o", "[exited 0 after 1.18s]\r\n"]
[9.74, "o", ""]
