{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.247, "o", "[exited 0 after 0.25s]\r\n"]
[1.247, "m", "Go to the home screen"]
[1.247, "o", "$ idb ui button HOME\r\n"]
[1.45, "o", "[exited 0 after 0.20s]\r\n"]
[1.679, "m", "Check what is where the banner will appear"]
[1.679, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.015, "o", "{\"role_description\":\"Group\",\"role\":\"AXGroup\",\"pid\":1295,\"title\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"frame\":{\"y\":0,\"x\":0,\"width\":402,\"height\":874},\"enabled\":true,\"traits\":[\"Scrollable\"],\"subrole\":null,\"AXValue\":null,\"content_required\":false,\"AXUniqueId\":null,\"help\":null,\"custom_actions\":[],\"AXLabel\":null,\"type\":\"Group\"}\r\n[exited 0 after 0.34s]\r\n"]
[2.016, "m", "Deliver a notification while the app is not running"]
[2.016, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.207, "o", "[exited 0 after 0.19s]\r\n"]
[3.209, "m", "Tap the banner"]
[3.209, "o", "$ idb ui tap 201 90\r\n"]
[3.757, "o", "[exited 0 after 0.55s]\r\n"]
[4.41, "m", "Clear the app's delivered notifications"]
[4.41, "o", "$ idb notification clear com.apple.news\r\n"]
[4.985, "o", "[exited 0 after 0.57s]\r\n"]
[5.512, "m", "List notifications after clearing them"]
[5.512, "o", "$ idb notification list com.apple.news\r\n"]
[5.962, "o", "[exited 0 after 0.45s]\r\n"]
[7.27, "o", ""]
