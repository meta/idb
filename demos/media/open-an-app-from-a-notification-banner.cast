{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.225, "o", "[exited 0 after 0.22s]\r\n"]
[1.225, "m", "Go to the home screen"]
[1.225, "o", "$ idb ui button HOME\r\n"]
[1.396, "o", "[exited 0 after 0.17s]\r\n"]
[1.605, "m", "Check what is where the banner will appear"]
[1.605, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.928, "o", "{\"AXValue\":null,\"AXUniqueId\":null,\"custom_actions\":[],\"AXLabel\":null,\"frame\":{\"width\":401.99999999999994,\"height\":874,\"y\":0,\"x\":0},\"pid\":1465,\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"type\":\"Group\",\"help\":null,\"content_required\":false,\"enabled\":true,\"subrole\":null,\"role\":\"AXGroup\",\"title\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\"}\r\n[exited 0 after 0.32s]\r\n"]
[1.928, "m", "Deliver a notification while the app is not running"]
[1.928, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.131, "o", "[exited 0 after 0.20s]\r\n"]
[3.133, "m", "Tap the banner"]
[3.133, "o", "$ idb ui tap 201 90\r\n"]
[3.38, "o", "[exited 0 after 0.25s]\r\n"]
[4.304, "m", "Clear the app's delivered notifications"]
[4.304, "o", "$ idb notification clear com.apple.news\r\n"]
[4.784, "o", "[exited 0 after 0.48s]\r\n"]
[5.311, "m", "List notifications after clearing them"]
[5.311, "o", "$ idb notification list com.apple.news\r\n"]
[5.759, "o", "[exited 0 after 0.45s]\r\n"]
[7.27, "o", ""]
