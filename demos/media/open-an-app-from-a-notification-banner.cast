{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.241, "o", "[exited 0 after 0.24s]\r\n"]
[1.241, "m", "Go to the home screen"]
[1.241, "o", "$ idb ui button HOME\r\n"]
[1.441, "o", "[exited 0 after 0.20s]\r\n"]
[1.71, "m", "Check what is where the banner will appear"]
[1.71, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.105, "o", "{\"subrole\":null,\"AXUniqueId\":null,\"enabled\":true,\"help\":null,\"AXValue\":null,\"role\":\"AXGroup\",\"title\":null,\"pid\":1788,\"custom_actions\":[],\"type\":\"Group\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"traits\":[\"Scrollable\"],\"frame\":{\"x\":0,\"width\":402,\"height\":874,\"y\":0},\"content_required\":false,\"AXLabel\":null,\"role_description\":\"Group\"}\r\n[exited 0 after 0.40s]\r\n"]
[2.105, "m", "Deliver a notification while the app is not running"]
[2.105, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.369, "o", "[exited 0 after 0.26s]\r\n"]
[3.374, "m", "Tap the banner"]
[3.374, "o", "$ idb ui tap 201 90\r\n"]
[3.707, "o", "[exited 0 after 0.33s]\r\n"]
[4.982, "m", "Clear the app's delivered notifications"]
[4.982, "o", "$ idb notification clear com.apple.news\r\n"]
[5.619, "o", "[exited 0 after 0.64s]\r\n"]
[6.145, "m", "List notifications after clearing them"]
[6.145, "o", "$ idb notification list com.apple.news\r\n"]
[6.937, "o", "[exited 0 after 0.79s]\r\n"]
[8.707, "o", ""]
