{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.237, "o", "[exited 0 after 0.24s]\r\n"]
[1.237, "m", "Go to the home screen"]
[1.237, "o", "$ idb ui button HOME\r\n"]
[1.426, "o", "[exited 0 after 0.19s]\r\n"]
[1.693, "m", "Check what is where the banner will appear"]
[1.693, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.093, "o", "{\"role_description\":\"Group\",\"pid\":1276,\"enabled\":true,\"content_required\":false,\"frame\":{\"width\":402.00000000000006,\"x\":0,\"y\":0,\"height\":874},\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"AXValue\":null,\"title\":null,\"AXUniqueId\":null,\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role\":\"AXGroup\",\"help\":null,\"AXLabel\":null,\"subrole\":null}\r\n[exited 0 after 0.40s]\r\n"]
[2.093, "m", "Deliver a notification while the app is not running"]
[2.093, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.343, "o", "[exited 0 after 0.25s]\r\n"]
[3.362, "m", "Tap the banner"]
[3.362, "o", "$ idb ui tap 201 90\r\n"]
[3.701, "o", "[exited 0 after 0.34s]\r\n"]
[4.762, "m", "Clear the app's delivered notifications"]
[4.762, "o", "$ idb notification clear com.apple.news\r\n"]
[5.408, "o", "[exited 0 after 0.65s]\r\n"]
[5.997, "m", "List notifications after clearing them"]
[5.997, "o", "$ idb notification list com.apple.news\r\n"]
[6.453, "o", "[exited 0 after 0.46s]\r\n"]
[8.288, "o", ""]
