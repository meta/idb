{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.959, "m", "Grant notification permission without showing a prompt"]
[0.959, "o", "$ idb approve com.apple.news notification\r\n"]
[1.193, "o", "[exited 0 after 0.23s]\r\n"]
[1.193, "m", "Go to the home screen"]
[1.193, "o", "$ idb ui button HOME\r\n"]
[1.368, "o", "[exited 0 after 0.17s]\r\n"]
[1.627, "m", "Check what is where the banner will appear"]
[1.627, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.169, "o", "{\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"role_description\":\"Group\",\"pid\":1344,\"AXLabel\":null,\"type\":\"Group\",\"AXUniqueId\":null,\"frame\":{\"width\":402,\"x\":0,\"y\":0,\"height\":874},\"help\":null,\"subrole\":null,\"content_required\":false,\"title\":null,\"enabled\":true,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.54s]\r\n"]
[2.17, "m", "Deliver a notification while the app is not running"]
[2.17, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.47, "o", "[exited 0 after 0.30s]\r\n"]
[3.472, "m", "Tap the banner"]
[3.472, "o", "$ idb ui tap 201 90\r\n"]
[3.722, "o", "[exited 0 after 0.25s]\r\n"]
[4.392, "m", "Clear the app's delivered notifications"]
[4.392, "o", "$ idb notification clear com.apple.news\r\n"]
[4.842, "o", "[exited 0 after 0.45s]\r\n"]
[5.364, "m", "List notifications after clearing them"]
[5.364, "o", "$ idb notification list com.apple.news\r\n"]
[5.803, "o", "[exited 0 after 0.44s]\r\n"]
[7.013, "o", ""]
