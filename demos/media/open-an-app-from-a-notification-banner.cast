{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.256, "o", "[exited 0 after 0.26s]\r\n"]
[1.256, "m", "Go to the home screen"]
[1.256, "o", "$ idb ui button HOME\r\n"]
[1.442, "o", "[exited 0 after 0.19s]\r\n"]
[1.688, "m", "Check what is where the banner will appear"]
[1.688, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.042, "o", "{\"custom_actions\":[],\"help\":null,\"pid\":1315,\"type\":\"Group\",\"content_required\":false,\"subrole\":null,\"AXValue\":null,\"AXUniqueId\":null,\"AXLabel\":null,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"enabled\":true,\"role_description\":\"Group\",\"title\":null,\"frame\":{\"y\":0,\"width\":402.00000000000006,\"x\":0,\"height\":874},\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.35s]\r\n"]
[2.042, "m", "Deliver a notification while the app is not running"]
[2.042, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.345, "o", "[exited 0 after 0.30s]\r\n"]
[3.347, "m", "Tap the banner"]
[3.347, "o", "$ idb ui tap 201 90\r\n"]
[4.212, "o", "[exited 0 after 0.87s]\r\n"]
[7.421, "m", "Clear the app's delivered notifications"]
[7.421, "o", "$ idb notification clear com.apple.news\r\n"]
[8.072, "o", "[exited 0 after 0.65s]\r\n"]
[8.545, "m", "List notifications after clearing them"]
[8.545, "o", "$ idb notification list com.apple.news\r\n"]
[8.961, "o", "[exited 0 after 0.42s]\r\n"]
[9.768, "o", ""]
