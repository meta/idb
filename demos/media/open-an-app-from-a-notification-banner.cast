{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.214, "o", "[exited 0 after 0.21s]\r\n"]
[1.214, "m", "Go to the home screen"]
[1.214, "o", "$ idb ui button HOME\r\n"]
[1.39, "o", "[exited 0 after 0.18s]\r\n"]
[1.627, "m", "Check what is where the banner will appear"]
[1.627, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.934, "o", "{\"frame\":{\"x\":0,\"y\":0,\"width\":402,\"height\":874},\"role\":\"AXGroup\",\"content_required\":false,\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"pid\":8063,\"enabled\":true,\"AXLabel\":null,\"help\":null,\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"custom_actions\":[],\"type\":\"Group\",\"title\":null,\"AXUniqueId\":null,\"subrole\":null}\r\n[exited 0 after 0.31s]\r\n"]
[1.934, "m", "Deliver a notification while the app is not running"]
[1.934, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.133, "o", "[exited 0 after 0.20s]\r\n"]
[3.136, "m", "Tap the banner"]
[3.136, "o", "$ idb ui tap 201 90\r\n"]
[3.443, "o", "[exited 0 after 0.31s]\r\n"]
[4.258, "m", "Clear the app's delivered notifications"]
[4.258, "o", "$ idb notification clear com.apple.news\r\n"]
[4.808, "o", "[exited 0 after 0.55s]\r\n"]
[5.369, "m", "List notifications after clearing them"]
[5.369, "o", "$ idb notification list com.apple.news\r\n"]
[5.847, "o", "[exited 0 after 0.48s]\r\n"]
[7.743, "o", ""]
