{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.228, "o", "[exited 0 after 0.23s]\r\n"]
[1.228, "m", "Go to the home screen"]
[1.228, "o", "$ idb ui button HOME\r\n"]
[1.421, "o", "[exited 0 after 0.19s]\r\n"]
[1.65, "m", "Check what is where the banner will appear"]
[1.65, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.057, "o", "{\"type\":\"Group\",\"role\":\"AXGroup\",\"content_required\":false,\"frame\":{\"width\":402.00000000000006,\"x\":0,\"height\":874,\"y\":0},\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"enabled\":true,\"pid\":3340,\"subrole\":null,\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"title\":null,\"AXUniqueId\":null,\"help\":null,\"AXLabel\":null,\"AXValue\":null,\"custom_actions\":[]}\r\n[exited 0 after 0.41s]\r\n"]
[2.058, "m", "Deliver a notification while the app is not running"]
[2.058, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.309, "o", "[exited 0 after 0.25s]\r\n"]
[3.312, "m", "Tap the banner"]
[3.312, "o", "$ idb ui tap 201 90\r\n"]
[3.791, "o", "[exited 0 after 0.48s]\r\n"]
[4.556, "m", "Clear the app's delivered notifications"]
[4.556, "o", "$ idb notification clear com.apple.news\r\n"]
[5.066, "o", "[exited 0 after 0.51s]\r\n"]
[5.602, "m", "List notifications after clearing them"]
[5.602, "o", "$ idb notification list com.apple.news\r\n"]
[6.138, "o", "[exited 0 after 0.54s]\r\n"]
[7.302, "o", ""]
