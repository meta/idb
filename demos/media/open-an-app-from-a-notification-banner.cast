{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.283, "o", "[exited 0 after 0.28s]\r\n"]
[1.283, "m", "Go to the home screen"]
[1.283, "o", "$ idb ui button HOME\r\n"]
[1.502, "o", "[exited 0 after 0.22s]\r\n"]
[1.749, "m", "Check what is where the banner will appear"]
[1.749, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.232, "o", "{\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"AXUniqueId\":null,\"AXValue\":null,\"content_required\":false,\"frame\":{\"y\":0,\"width\":402.00000000000006,\"height\":874,\"x\":0},\"AXLabel\":null,\"type\":\"Group\",\"title\":null,\"help\":null,\"pid\":1270,\"custom_actions\":[],\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"subrole\":null}\r\n[exited 0 after 0.48s]\r\n"]
[2.234, "m", "Deliver a notification while the app is not running"]
[2.234, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.596, "o", "[exited 0 after 0.36s]\r\n"]
[3.599, "m", "Tap the banner"]
[3.599, "o", "$ idb ui tap 201 90\r\n"]
[3.819, "o", "[exited 0 after 0.22s]\r\n"]
[4.815, "m", "Clear the app's delivered notifications"]
[4.815, "o", "$ idb notification clear com.apple.news\r\n"]
[5.361, "o", "[exited 0 after 0.55s]\r\n"]
[6.054, "m", "List notifications after clearing them"]
[6.054, "o", "$ idb notification list com.apple.news\r\n"]
[6.735, "o", "[exited 0 after 0.68s]\r\n"]
[8.46, "o", ""]
