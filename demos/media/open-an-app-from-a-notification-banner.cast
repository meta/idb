{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.274, "o", "[exited 0 after 0.27s]\r\n"]
[1.274, "m", "Go to the home screen"]
[1.274, "o", "$ idb ui button HOME\r\n"]
[1.474, "o", "[exited 0 after 0.20s]\r\n"]
[1.713, "m", "Check what is where the banner will appear"]
[1.713, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.046, "o", "{\"AXValue\":null,\"subrole\":null,\"help\":null,\"pid\":1970,\"type\":\"Group\",\"custom_actions\":[],\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"AXUniqueId\":null,\"traits\":[\"Scrollable\"],\"frame\":{\"x\":0,\"y\":0,\"width\":402,\"height\":874},\"AXLabel\":null,\"content_required\":false,\"role\":\"AXGroup\",\"title\":null,\"enabled\":true}\r\n[exited 0 after 0.33s]\r\n"]
[2.047, "m", "Deliver a notification while the app is not running"]
[2.047, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.25, "o", "[exited 0 after 0.20s]\r\n"]
[3.256, "m", "Tap the banner"]
[3.256, "o", "$ idb ui tap 201 90\r\n"]
[3.526, "o", "[exited 0 after 0.27s]\r\n"]
[4.47, "m", "Clear the app's delivered notifications"]
[4.47, "o", "$ idb notification clear com.apple.news\r\n"]
[5.051, "o", "[exited 0 after 0.58s]\r\n"]
[5.666, "m", "List notifications after clearing them"]
[5.666, "o", "$ idb notification list com.apple.news\r\n"]
[6.323, "o", "[exited 0 after 0.66s]\r\n"]
[8.048, "o", ""]
