{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.379, "o", "[exited 0 after 0.38s]\r\n"]
[1.38, "m", "Go to the home screen"]
[1.38, "o", "$ idb ui button HOME\r\n"]
[1.601, "o", "[exited 0 after 0.22s]\r\n"]
[1.85, "m", "Check what is where the banner will appear"]
[1.85, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.289, "o", "{\"subrole\":null,\"AXLabel\":null,\"role\":\"AXGroup\",\"frame\":{\"width\":402,\"x\":0,\"y\":0,\"height\":874},\"AXValue\":null,\"type\":\"Group\",\"title\":null,\"content_required\":false,\"help\":null,\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"enabled\":true,\"pid\":1282,\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"custom_actions\":[]}\r\n[exited 0 after 0.44s]\r\n"]
[2.289, "m", "Deliver a notification while the app is not running"]
[2.289, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.576, "o", "[exited 0 after 0.29s]\r\n"]
[3.579, "m", "Tap the banner"]
[3.579, "o", "$ idb ui tap 201 90\r\n"]
[4.434, "o", "[exited 0 after 0.86s]\r\n"]
[7.621, "m", "Clear the app's delivered notifications"]
[7.621, "o", "$ idb notification clear com.apple.news\r\n"]
[9.453, "o", "[exited 0 after 1.83s]\r\n"]
[10.4, "m", "List notifications after clearing them"]
[10.4, "o", "$ idb notification list com.apple.news\r\n"]
[11.174, "o", "[exited 0 after 0.77s]\r\n"]
[12.422, "o", ""]
