{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.217, "o", "[exited 0 after 0.22s]\r\n"]
[1.217, "m", "Go to the home screen"]
[1.217, "o", "$ idb ui button HOME\r\n"]
[1.383, "o", "[exited 0 after 0.17s]\r\n"]
[1.587, "m", "Check what is where the banner will appear"]
[1.587, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.952, "o", "{\"AXLabel\":null,\"content_required\":false,\"role\":\"AXGroup\",\"AXValue\":null,\"help\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"frame\":{\"width\":402.00000000000006,\"x\":0,\"height\":874,\"y\":0},\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"title\":null,\"role_description\":\"Group\",\"AXUniqueId\":null,\"type\":\"Group\",\"pid\":1312,\"subrole\":null,\"enabled\":true}\r\n[exited 0 after 0.36s]\r\n"]
[1.952, "m", "Deliver a notification while the app is not running"]
[1.952, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.15, "o", "[exited 0 after 0.20s]\r\n"]
[3.153, "m", "Tap the banner"]
[3.153, "o", "$ idb ui tap 201 90\r\n"]
[3.405, "o", "[exited 0 after 0.25s]\r\n"]
[4.102, "m", "Clear the app's delivered notifications"]
[4.102, "o", "$ idb notification clear com.apple.news\r\n"]
[4.563, "o", "[exited 0 after 0.46s]\r\n"]
[5.066, "m", "List notifications after clearing them"]
[5.066, "o", "$ idb notification list com.apple.news\r\n"]
[5.486, "o", "[exited 0 after 0.42s]\r\n"]
[6.795, "o", ""]
