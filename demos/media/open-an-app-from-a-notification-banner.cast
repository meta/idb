{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.241, "o", "[exited 0 after 0.24s]\r\n"]
[1.241, "m", "Go to the home screen"]
[1.241, "o", "$ idb ui button HOME\r\n"]
[1.453, "o", "[exited 0 after 0.21s]\r\n"]
[1.707, "m", "Check what is where the banner will appear"]
[1.707, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.317, "o", "{\"AXValue\":null,\"title\":null,\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"AXLabel\":null,\"frame\":{\"y\":0,\"width\":402,\"x\":0,\"height\":874},\"type\":\"Group\",\"custom_actions\":[],\"role\":\"AXGroup\",\"subrole\":null,\"content_required\":false,\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"enabled\":true,\"pid\":1910,\"role_description\":\"Group\"}\r\n[exited 0 after 0.61s]\r\n"]
[2.317, "m", "Deliver a notification while the app is not running"]
[2.317, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.571, "o", "[exited 0 after 0.25s]\r\n"]
[3.575, "m", "Tap the banner"]
[3.575, "o", "$ idb ui tap 201 90\r\n"]
[3.774, "o", "[exited 0 after 0.20s]\r\n"]
[4.378, "m", "Clear the app's delivered notifications"]
[4.378, "o", "$ idb notification clear com.apple.news\r\n"]
[4.822, "o", "[exited 0 after 0.44s]\r\n"]
[5.323, "m", "List notifications after clearing them"]
[5.323, "o", "$ idb notification list com.apple.news\r\n"]
[5.814, "o", "[exited 0 after 0.49s]\r\n"]
[7.162, "o", ""]
