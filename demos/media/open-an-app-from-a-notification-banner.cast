{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.213, "o", "[exited 0 after 0.21s]\r\n"]
[1.213, "m", "Go to the home screen"]
[1.213, "o", "$ idb ui button HOME\r\n"]
[1.39, "o", "[exited 0 after 0.18s]\r\n"]
[1.595, "m", "Check what is where the banner will appear"]
[1.595, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.93, "o", "{\"role_description\":\"Group\",\"role\":\"AXGroup\",\"enabled\":true,\"type\":\"Group\",\"custom_actions\":[],\"subrole\":null,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"help\":null,\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":401.99999999999994},\"AXUniqueId\":null,\"title\":null,\"pid\":1635,\"traits\":[\"Scrollable\"],\"AXValue\":null,\"AXLabel\":null}\r\n[exited 0 after 0.33s]\r\n"]
[1.93, "m", "Deliver a notification while the app is not running"]
[1.93, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.143, "o", "[exited 0 after 0.21s]\r\n"]
[3.146, "m", "Tap the banner"]
[3.146, "o", "$ idb ui tap 201 90\r\n"]
[3.384, "o", "[exited 0 after 0.24s]\r\n"]
[4.381, "m", "Clear the app's delivered notifications"]
[4.381, "o", "$ idb notification clear com.apple.news\r\n"]
[5.032, "o", "[exited 0 after 0.65s]\r\n"]
[5.486, "m", "List notifications after clearing them"]
[5.486, "o", "$ idb notification list com.apple.news\r\n"]
[6.296, "o", "[exited 0 after 0.81s]\r\n"]
[7.335, "o", ""]
