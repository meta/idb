{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.252, "o", "[exited 0 after 0.25s]\r\n"]
[1.252, "m", "Go to the home screen"]
[1.252, "o", "$ idb ui button HOME\r\n"]
[1.491, "o", "[exited 0 after 0.24s]\r\n"]
[1.749, "m", "Check what is where the banner will appear"]
[1.749, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.133, "o", "{\"type\":\"Group\",\"content_required\":false,\"traits\":[\"Scrollable\"],\"frame\":{\"x\":0,\"width\":402,\"y\":0,\"height\":874},\"enabled\":true,\"custom_actions\":[],\"subrole\":null,\"AXLabel\":null,\"role\":\"AXGroup\",\"role_description\":\"Group\",\"AXValue\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"title\":null,\"help\":null,\"pid\":2270,\"AXUniqueId\":null}\r\n[exited 0 after 0.38s]\r\n"]
[2.134, "m", "Deliver a notification while the app is not running"]
[2.134, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.343, "o", "[exited 0 after 0.21s]\r\n"]
[3.347, "m", "Tap the banner"]
[3.347, "o", "$ idb ui tap 201 90\r\n"]
[3.624, "o", "[exited 0 after 0.28s]\r\n"]
[4.322, "m", "Clear the app's delivered notifications"]
[4.322, "o", "$ idb notification clear com.apple.news\r\n"]
[4.745, "o", "[exited 0 after 0.42s]\r\n"]
[5.253, "m", "List notifications after clearing them"]
[5.253, "o", "$ idb notification list com.apple.news\r\n"]
[5.8, "o", "[exited 0 after 0.55s]\r\n"]
[7.358, "o", ""]
