{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.297, "o", "[exited 0 after 0.30s]\r\n"]
[1.297, "m", "Go to the home screen"]
[1.297, "o", "$ idb ui button HOME\r\n"]
[1.617, "o", "[exited 0 after 0.32s]\r\n"]
[1.854, "m", "Check what is where the banner will appear"]
[1.854, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.329, "o", "{\"subrole\":null,\"type\":\"Group\",\"custom_actions\":[],\"content_required\":false,\"AXValue\":null,\"role\":\"AXGroup\",\"role_description\":\"Group\",\"AXLabel\":null,\"title\":null,\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":402},\"enabled\":true,\"AXUniqueId\":null,\"pid\":1286,\"traits\":[\"Scrollable\"],\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\"}\r\n[exited 0 after 0.48s]\r\n"]
[2.33, "m", "Deliver a notification while the app is not running"]
[2.33, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.574, "o", "[exited 0 after 0.24s]\r\n"]
[3.578, "m", "Tap the banner"]
[3.578, "o", "$ idb ui tap 201 90\r\n"]
[3.9, "o", "[exited 0 after 0.32s]\r\n"]
[4.97, "m", "Clear the app's delivered notifications"]
[4.97, "o", "$ idb notification clear com.apple.news\r\n"]
[5.634, "o", "[exited 0 after 0.66s]\r\n"]
[6.117, "m", "List notifications after clearing them"]
[6.117, "o", "$ idb notification list com.apple.news\r\n"]
[6.725, "o", "[exited 0 after 0.61s]\r\n"]
[8.715, "o", ""]
