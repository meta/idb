{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.911, "m", "Grant notification permission without showing a prompt"]
[0.911, "o", "$ idb approve com.apple.news notification\r\n"]
[1.135, "o", "[exited 0 after 0.22s]\r\n"]
[1.135, "m", "Go to the home screen"]
[1.135, "o", "$ idb ui button HOME\r\n"]
[1.3, "o", "[exited 0 after 0.17s]\r\n"]
[1.53, "m", "Check what is where the banner will appear"]
[1.53, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.878, "o", "{\"AXLabel\":null,\"AXUniqueId\":null,\"title\":null,\"frame\":{\"y\":0,\"height\":874,\"width\":401.99999999999994,\"x\":0},\"pid\":12327,\"subrole\":null,\"traits\":[\"Scrollable\"],\"help\":null,\"AXValue\":null,\"role\":\"AXGroup\",\"type\":\"Group\",\"enabled\":true,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"content_required\":false,\"role_description\":\"Group\",\"custom_actions\":[]}\r\n[exited 0 after 0.35s]\r\n"]
[1.878, "m", "Deliver a notification while the app is not running"]
[1.878, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.065, "o", "[exited 0 after 0.19s]\r\n"]
[3.067, "m", "Tap the banner"]
[3.067, "o", "$ idb ui tap 201 90\r\n"]
[3.297, "o", "[exited 0 after 0.23s]\r\n"]
[3.986, "m", "Clear the app's delivered notifications"]
[3.986, "o", "$ idb notification clear com.apple.news\r\n"]
[4.399, "o", "[exited 0 after 0.41s]\r\n"]
[4.845, "m", "List notifications after clearing them"]
[4.845, "o", "$ idb notification list com.apple.news\r\n"]
[5.269, "o", "[exited 0 after 0.42s]\r\n"]
[6.597, "o", ""]
