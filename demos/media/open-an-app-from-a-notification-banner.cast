{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.237, "o", "[exited 0 after 0.24s]\r\n"]
[1.237, "m", "Go to the home screen"]
[1.237, "o", "$ idb ui button HOME\r\n"]
[1.459, "o", "[exited 0 after 0.22s]\r\n"]
[1.723, "m", "Check what is where the banner will appear"]
[1.723, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.08, "o", "{\"role_description\":\"Group\",\"enabled\":true,\"AXUniqueId\":null,\"subrole\":null,\"content_required\":false,\"role\":\"AXGroup\",\"AXValue\":null,\"help\":null,\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"frame\":{\"height\":874,\"x\":0,\"y\":0,\"width\":401.99999999999994},\"pid\":1277,\"custom_actions\":[],\"title\":null,\"type\":\"Group\",\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.36s]\r\n"]
[2.08, "m", "Deliver a notification while the app is not running"]
[2.08, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.289, "o", "[exited 0 after 0.21s]\r\n"]
[3.292, "m", "Tap the banner"]
[3.292, "o", "$ idb ui tap 201 90\r\n"]
[3.639, "o", "[exited 0 after 0.35s]\r\n"]
[4.445, "m", "Clear the app's delivered notifications"]
[4.445, "o", "$ idb notification clear com.apple.news\r\n"]
[4.936, "o", "[exited 0 after 0.49s]\r\n"]
[5.516, "m", "List notifications after clearing them"]
[5.516, "o", "$ idb notification list com.apple.news\r\n"]
[6.056, "o", "[exited 0 after 0.54s]\r\n"]
[7.57, "o", ""]
