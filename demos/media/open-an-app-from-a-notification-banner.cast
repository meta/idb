{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.272, "o", "[exited 0 after 0.27s]\r\n"]
[1.272, "m", "Go to the home screen"]
[1.272, "o", "$ idb ui button HOME\r\n"]
[1.471, "o", "[exited 0 after 0.20s]\r\n"]
[1.706, "m", "Check what is where the banner will appear"]
[1.706, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.149, "o", "{\"content_required\":false,\"AXLabel\":null,\"help\":null,\"enabled\":true,\"role_description\":\"Group\",\"AXUniqueId\":null,\"title\":null,\"AXValue\":null,\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":402},\"traits\":[\"Scrollable\"],\"subrole\":null,\"pid\":2771,\"custom_actions\":[],\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"type\":\"Group\"}\r\n[exited 0 after 0.44s]\r\n"]
[2.15, "m", "Deliver a notification while the app is not running"]
[2.15, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.402, "o", "[exited 0 after 0.25s]\r\n"]
[3.405, "m", "Tap the banner"]
[3.405, "o", "$ idb ui tap 201 90\r\n"]
[3.652, "o", "[exited 0 after 0.25s]\r\n"]
[5.114, "m", "Clear the app's delivered notifications"]
[5.114, "o", "$ idb notification clear com.apple.news\r\n"]
[5.784, "o", "[exited 0 after 0.67s]\r\n"]
[6.261, "m", "List notifications after clearing them"]
[6.261, "o", "$ idb notification list com.apple.news\r\n"]
[7.23, "o", "[exited 0 after 0.97s]\r\n"]
[8.447, "o", ""]
