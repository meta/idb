{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.25, "o", "[exited 0 after 0.25s]\r\n"]
[1.25, "m", "Go to the home screen"]
[1.25, "o", "$ idb ui button HOME\r\n"]
[1.445, "o", "[exited 0 after 0.20s]\r\n"]
[1.684, "m", "Check what is where the banner will appear"]
[1.684, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.16, "o", "{\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"custom_actions\":[],\"pid\":1305,\"AXUniqueId\":null,\"help\":null,\"frame\":{\"x\":0,\"width\":402.00000000000006,\"y\":0,\"height\":874},\"role_description\":\"Group\",\"type\":\"Group\",\"AXValue\":null,\"subrole\":null,\"traits\":[\"Scrollable\"],\"enabled\":true,\"title\":null,\"content_required\":false,\"AXLabel\":null}\r\n[exited 0 after 0.48s]\r\n"]
[2.161, "m", "Deliver a notification while the app is not running"]
[2.161, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.448, "o", "[exited 0 after 0.29s]\r\n"]
[3.452, "m", "Tap the banner"]
[3.452, "o", "$ idb ui tap 201 90\r\n"]
[3.725, "o", "[exited 0 after 0.27s]\r\n"]
[4.773, "m", "Clear the app's delivered notifications"]
[4.773, "o", "$ idb notification clear com.apple.news\r\n"]
[5.369, "o", "[exited 0 after 0.60s]\r\n"]
[5.992, "m", "List notifications after clearing them"]
[5.992, "o", "$ idb notification list com.apple.news\r\n"]
[6.542, "o", "[exited 0 after 0.55s]\r\n"]
[8.432, "o", ""]
