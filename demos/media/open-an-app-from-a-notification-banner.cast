{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.283, "o", "[exited 0 after 0.28s]\r\n"]
[1.284, "m", "Go to the home screen"]
[1.284, "o", "$ idb ui button HOME\r\n"]
[1.478, "o", "[exited 0 after 0.19s]\r\n"]
[1.707, "m", "Check what is where the banner will appear"]
[1.707, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.147, "o", "{\"type\":\"Group\",\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"role\":\"AXGroup\",\"AXLabel\":null,\"frame\":{\"x\":0,\"width\":402,\"y\":0,\"height\":874},\"content_required\":false,\"help\":null,\"role_description\":\"Group\",\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"subrole\":null,\"title\":null,\"pid\":1302,\"AXUniqueId\":null,\"enabled\":true,\"AXValue\":null}\r\n[exited 0 after 0.44s]\r\n"]
[2.148, "m", "Deliver a notification while the app is not running"]
[2.148, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.424, "o", "[exited 0 after 0.28s]\r\n"]
[3.427, "m", "Tap the banner"]
[3.427, "o", "$ idb ui tap 201 90\r\n"]
[4.21, "o", "[exited 0 after 0.78s]\r\n"]
[7.0, "m", "Clear the app's delivered notifications"]
[7.0, "o", "$ idb notification clear com.apple.news\r\n"]
[7.901, "o", "[exited 0 after 0.90s]\r\n"]
[8.513, "m", "List notifications after clearing them"]
[8.513, "o", "$ idb notification list com.apple.news\r\n"]
[9.022, "o", "[exited 0 after 0.51s]\r\n"]
[9.815, "o", ""]
