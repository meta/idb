{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.319, "o", "[exited 0 after 0.32s]\r\n"]
[1.319, "m", "Go to the home screen"]
[1.319, "o", "$ idb ui button HOME\r\n"]
[1.524, "o", "[exited 0 after 0.20s]\r\n"]
[1.771, "m", "Check what is where the banner will appear"]
[1.771, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.229, "o", "{\"enabled\":true,\"title\":null,\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":401.99999999999994},\"custom_actions\":[],\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXLabel\":null,\"help\":null,\"AXValue\":null,\"AXUniqueId\":null,\"role_description\":\"Group\",\"type\":\"Group\",\"pid\":1325,\"content_required\":false,\"subrole\":null,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.46s]\r\n"]
[2.229, "m", "Deliver a notification while the app is not running"]
[2.229, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.531, "o", "[exited 0 after 0.30s]\r\n"]
[3.534, "m", "Tap the banner"]
[3.534, "o", "$ idb ui tap 201 90\r\n"]
[3.805, "o", "[exited 0 after 0.27s]\r\n"]
[4.632, "m", "Clear the app's delivered notifications"]
[4.632, "o", "$ idb notification clear com.apple.news\r\n"]
[5.267, "o", "[exited 0 after 0.64s]\r\n"]
[6.039, "m", "List notifications after clearing them"]
[6.039, "o", "$ idb notification list com.apple.news\r\n"]
[6.54, "o", "[exited 0 after 0.50s]\r\n"]
[8.348, "o", ""]
