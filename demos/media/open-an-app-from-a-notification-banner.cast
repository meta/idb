{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.247, "o", "[exited 0 after 0.25s]\r\n"]
[1.247, "m", "Go to the home screen"]
[1.247, "o", "$ idb ui button HOME\r\n"]
[1.446, "o", "[exited 0 after 0.20s]\r\n"]
[1.678, "m", "Check what is where the banner will appear"]
[1.678, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.138, "o", "{\"traits\":[\"Scrollable\"],\"help\":null,\"enabled\":true,\"AXValue\":null,\"type\":\"Group\",\"frame\":{\"y\":0,\"x\":0,\"height\":874,\"width\":402.00000000000006},\"subrole\":null,\"pid\":1283,\"AXLabel\":null,\"AXUniqueId\":null,\"title\":null,\"content_required\":false,\"custom_actions\":[],\"role_description\":\"Group\",\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\"}\r\n[exited 0 after 0.46s]\r\n"]
[2.138, "m", "Deliver a notification while the app is not running"]
[2.138, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.412, "o", "[exited 0 after 0.27s]\r\n"]
[3.414, "m", "Tap the banner"]
[3.414, "o", "$ idb ui tap 201 90\r\n"]
[3.679, "o", "[exited 0 after 0.26s]\r\n"]
[4.342, "m", "Clear the app's delivered notifications"]
[4.342, "o", "$ idb notification clear com.apple.news\r\n"]
[4.861, "o", "[exited 0 after 0.52s]\r\n"]
[5.55, "m", "List notifications after clearing them"]
[5.55, "o", "$ idb notification list com.apple.news\r\n"]
[6.066, "o", "[exited 0 after 0.52s]\r\n"]
[7.683, "o", ""]
