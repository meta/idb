{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.272, "o", "[exited 0 after 0.27s]\r\n"]
[1.272, "m", "Go to the home screen"]
[1.272, "o", "$ idb ui button HOME\r\n"]
[1.513, "o", "[exited 0 after 0.24s]\r\n"]
[1.761, "m", "Check what is where the banner will appear"]
[1.761, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.115, "o", "{\"AXUniqueId\":null,\"pid\":1282,\"frame\":{\"x\":0,\"height\":874,\"width\":401.99999999999994,\"y\":0},\"role\":\"AXGroup\",\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"title\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"enabled\":true,\"help\":null,\"subrole\":null,\"AXValue\":null,\"custom_actions\":[],\"AXLabel\":null,\"type\":\"Group\",\"content_required\":false}\r\n[exited 0 after 0.35s]\r\n"]
[2.115, "m", "Deliver a notification while the app is not running"]
[2.115, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.327, "o", "[exited 0 after 0.21s]\r\n"]
[3.332, "m", "Tap the banner"]
[3.332, "o", "$ idb ui tap 201 90\r\n"]
[3.723, "o", "[exited 0 after 0.39s]\r\n"]
[4.657, "m", "Clear the app's delivered notifications"]
[4.657, "o", "$ idb notification clear com.apple.news\r\n"]
[5.188, "o", "[exited 0 after 0.53s]\r\n"]
[5.735, "m", "List notifications after clearing them"]
[5.735, "o", "$ idb notification list com.apple.news\r\n"]
[6.24, "o", "[exited 0 after 0.50s]\r\n"]
[7.843, "o", ""]
