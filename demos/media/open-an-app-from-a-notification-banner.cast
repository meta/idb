{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.207, "o", "[exited 0 after 0.21s]\r\n"]
[1.207, "m", "Go to the home screen"]
[1.207, "o", "$ idb ui button HOME\r\n"]
[1.396, "o", "[exited 0 after 0.19s]\r\n"]
[1.607, "m", "Check what is where the banner will appear"]
[1.607, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.918, "o", "{\"subrole\":null,\"role\":\"AXGroup\",\"title\":null,\"AXValue\":null,\"help\":null,\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"role_description\":\"Group\",\"frame\":{\"height\":874,\"y\":0,\"width\":402,\"x\":0},\"enabled\":true,\"pid\":1333,\"type\":\"Group\",\"AXUniqueId\":null,\"content_required\":false}\r\n[exited 0 after 0.31s]\r\n"]
[1.919, "m", "Deliver a notification while the app is not running"]
[1.919, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.124, "o", "[exited 0 after 0.21s]\r\n"]
[3.127, "m", "Tap the banner"]
[3.127, "o", "$ idb ui tap 201 90\r\n"]
[3.381, "o", "[exited 0 after 0.25s]\r\n"]
[3.979, "m", "Clear the app's delivered notifications"]
[3.979, "o", "$ idb notification clear com.apple.news\r\n"]
[4.398, "o", "[exited 0 after 0.42s]\r\n"]
[4.875, "m", "List notifications after clearing them"]
[4.875, "o", "$ idb notification list com.apple.news\r\n"]
[5.367, "o", "[exited 0 after 0.49s]\r\n"]
[6.572, "o", ""]
