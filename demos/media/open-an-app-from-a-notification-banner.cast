{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.238, "o", "[exited 0 after 0.24s]\r\n"]
[1.238, "m", "Go to the home screen"]
[1.238, "o", "$ idb ui button HOME\r\n"]
[1.435, "o", "[exited 0 after 0.20s]\r\n"]
[1.677, "m", "Check what is where the banner will appear"]
[1.677, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.188, "o", "{\"help\":null,\"role\":\"AXGroup\",\"enabled\":true,\"AXValue\":null,\"role_description\":\"Group\",\"subrole\":null,\"custom_actions\":[],\"content_required\":false,\"AXLabel\":null,\"frame\":{\"height\":874,\"x\":0,\"width\":402,\"y\":0},\"AXUniqueId\":null,\"title\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"pid\":1324}\r\n[exited 0 after 0.51s]\r\n"]
[2.189, "m", "Deliver a notification while the app is not running"]
[2.189, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.471, "o", "[exited 0 after 0.28s]\r\n"]
[3.475, "m", "Tap the banner"]
[3.475, "o", "$ idb ui tap 201 90\r\n"]
[3.697, "o", "[exited 0 after 0.22s]\r\n"]
[4.376, "m", "Clear the app's delivered notifications"]
[4.376, "o", "$ idb notification clear com.apple.news\r\n"]
[4.877, "o", "[exited 0 after 0.50s]\r\n"]
[5.362, "m", "List notifications after clearing them"]
[5.362, "o", "$ idb notification list com.apple.news\r\n"]
[5.912, "o", "[exited 0 after 0.55s]\r\n"]
[7.247, "o", ""]
