{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.21, "o", "[exited 0 after 0.21s]\r\n"]
[1.21, "m", "Go to the home screen"]
[1.21, "o", "$ idb ui button HOME\r\n"]
[1.379, "o", "[exited 0 after 0.17s]\r\n"]
[1.63, "m", "Check what is where the banner will appear"]
[1.63, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.968, "o", "{\"help\":null,\"AXUniqueId\":null,\"AXValue\":null,\"title\":null,\"type\":\"Group\",\"subrole\":null,\"pid\":1270,\"custom_actions\":[],\"AXLabel\":null,\"frame\":{\"height\":874,\"y\":0,\"width\":402.00000000000006,\"x\":0},\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"content_required\":false}\r\n[exited 0 after 0.34s]\r\n"]
[1.969, "m", "Deliver a notification while the app is not running"]
[1.969, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.207, "o", "[exited 0 after 0.24s]\r\n"]
[3.214, "m", "Tap the banner"]
[3.214, "o", "$ idb ui tap 201 90\r\n"]
[3.695, "o", "[exited 0 after 0.48s]\r\n"]
[4.256, "m", "Clear the app's delivered notifications"]
[4.256, "o", "$ idb notification clear com.apple.news\r\n"]
[4.731, "o", "[exited 0 after 0.47s]\r\n"]
[5.274, "m", "List notifications after clearing them"]
[5.274, "o", "$ idb notification list com.apple.news\r\n"]
[5.793, "o", "[exited 0 after 0.52s]\r\n"]
[7.168, "o", ""]
