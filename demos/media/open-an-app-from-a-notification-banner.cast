{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.239, "o", "[exited 0 after 0.24s]\r\n"]
[1.239, "m", "Go to the home screen"]
[1.239, "o", "$ idb ui button HOME\r\n"]
[1.43, "o", "[exited 0 after 0.19s]\r\n"]
[1.688, "m", "Check what is where the banner will appear"]
[1.688, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.389, "o", "{\"AXLabel\":null,\"AXValue\":null,\"type\":\"Group\",\"title\":null,\"role\":\"AXGroup\",\"AXUniqueId\":null,\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"role_description\":\"Group\",\"subrole\":null,\"pid\":2329,\"help\":null,\"frame\":{\"y\":0,\"width\":402,\"x\":0,\"height\":874},\"custom_actions\":[],\"content_required\":false,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.70s]\r\n"]
[2.389, "m", "Deliver a notification while the app is not running"]
[2.389, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.656, "o", "[exited 0 after 0.27s]\r\n"]
[3.659, "m", "Tap the banner"]
[3.659, "o", "$ idb ui tap 201 90\r\n"]
[3.868, "o", "[exited 0 after 0.21s]\r\n"]
[4.862, "m", "Clear the app's delivered notifications"]
[4.862, "o", "$ idb notification clear com.apple.news\r\n"]
[5.407, "o", "[exited 0 after 0.54s]\r\n"]
[5.94, "m", "List notifications after clearing them"]
[5.94, "o", "$ idb notification list com.apple.news\r\n"]
[6.434, "o", "[exited 0 after 0.49s]\r\n"]
[8.008, "o", ""]
