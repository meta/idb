{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.234, "o", "[exited 0 after 0.23s]\r\n"]
[1.235, "m", "Go to the home screen"]
[1.235, "o", "$ idb ui button HOME\r\n"]
[1.415, "o", "[exited 0 after 0.18s]\r\n"]
[1.661, "m", "Check what is where the banner will appear"]
[1.661, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.108, "o", "{\"AXLabel\":null,\"role_description\":\"Group\",\"enabled\":true,\"traits\":[\"Scrollable\"],\"title\":null,\"content_required\":false,\"type\":\"Group\",\"pid\":1362,\"frame\":{\"x\":0,\"width\":401.99999999999994,\"height\":874,\"y\":0},\"AXValue\":null,\"help\":null,\"subrole\":null,\"AXUniqueId\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"role\":\"AXGroup\",\"custom_actions\":[]}\r\n[exited 0 after 0.45s]\r\n"]
[2.108, "m", "Deliver a notification while the app is not running"]
[2.108, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.431, "o", "[exited 0 after 0.32s]\r\n"]
[3.435, "m", "Tap the banner"]
[3.435, "o", "$ idb ui tap 201 90\r\n"]
[3.682, "o", "[exited 0 after 0.25s]\r\n"]
[4.66, "m", "Clear the app's delivered notifications"]
[4.66, "o", "$ idb notification clear com.apple.news\r\n"]
[5.215, "o", "[exited 0 after 0.56s]\r\n"]
[5.851, "m", "List notifications after clearing them"]
[5.851, "o", "$ idb notification list com.apple.news\r\n"]
[6.311, "o", "[exited 0 after 0.46s]\r\n"]
[8.457, "o", ""]
