{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.247, "o", "[exited 0 after 0.25s]\r\n"]
[1.248, "m", "Go to the home screen"]
[1.248, "o", "$ idb ui button HOME\r\n"]
[1.472, "o", "[exited 0 after 0.22s]\r\n"]
[1.717, "m", "Check what is where the banner will appear"]
[1.717, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.076, "o", "{\"type\":\"Group\",\"AXUniqueId\":null,\"pid\":1594,\"role\":\"AXGroup\",\"role_description\":\"Group\",\"help\":null,\"AXLabel\":null,\"enabled\":true,\"frame\":{\"x\":0,\"height\":874,\"width\":401.99999999999994,\"y\":0},\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"custom_actions\":[],\"title\":null,\"AXValue\":null,\"subrole\":null,\"content_required\":false,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.36s]\r\n"]
[2.077, "m", "Deliver a notification while the app is not running"]
[2.077, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.303, "o", "[exited 0 after 0.23s]\r\n"]
[3.309, "m", "Tap the banner"]
[3.309, "o", "$ idb ui tap 201 90\r\n"]
[3.65, "o", "[exited 0 after 0.34s]\r\n"]
[4.616, "m", "Clear the app's delivered notifications"]
[4.616, "o", "$ idb notification clear com.apple.news\r\n"]
[5.191, "o", "[exited 0 after 0.57s]\r\n"]
[5.735, "m", "List notifications after clearing them"]
[5.735, "o", "$ idb notification list com.apple.news\r\n"]
[6.323, "o", "[exited 0 after 0.59s]\r\n"]
[8.013, "o", ""]
