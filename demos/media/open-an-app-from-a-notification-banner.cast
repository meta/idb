{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.249, "o", "[exited 0 after 0.25s]\r\n"]
[1.249, "m", "Go to the home screen"]
[1.249, "o", "$ idb ui button HOME\r\n"]
[1.434, "o", "[exited 0 after 0.18s]\r\n"]
[1.682, "m", "Check what is where the banner will appear"]
[1.682, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.063, "o", "{\"AXUniqueId\":null,\"frame\":{\"y\":0,\"width\":401.99999999999994,\"height\":874,\"x\":0},\"AXLabel\":null,\"role\":\"AXGroup\",\"type\":\"Group\",\"role_description\":\"Group\",\"title\":null,\"subrole\":null,\"content_required\":false,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"pid\":1273,\"enabled\":true,\"AXValue\":null,\"help\":null}\r\n[exited 0 after 0.38s]\r\n"]
[2.064, "m", "Deliver a notification while the app is not running"]
[2.064, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.305, "o", "[exited 0 after 0.24s]\r\n"]
[3.308, "m", "Tap the banner"]
[3.308, "o", "$ idb ui tap 201 90\r\n"]
[3.585, "o", "[exited 0 after 0.28s]\r\n"]
[4.466, "m", "Clear the app's delivered notifications"]
[4.466, "o", "$ idb notification clear com.apple.news\r\n"]
[5.047, "o", "[exited 0 after 0.58s]\r\n"]
[5.583, "m", "List notifications after clearing them"]
[5.583, "o", "$ idb notification list com.apple.news\r\n"]
[6.015, "o", "[exited 0 after 0.43s]\r\n"]
[7.49, "o", ""]
