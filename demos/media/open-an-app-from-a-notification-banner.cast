{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[0.91, "m", "Grant notification permission without showing a prompt"]
[0.91, "o", "$ idb approve com.apple.news notification\r\n"]
[1.121, "o", "[exited 0 after 0.21s]\r\n"]
[1.122, "m", "Go to the home screen"]
[1.122, "o", "$ idb ui button HOME\r\n"]
[1.274, "o", "[exited 0 after 0.15s]\r\n"]
[1.483, "m", "Check what is where the banner will appear"]
[1.483, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.811, "o", "{\"AXLabel\":null,\"type\":\"Group\",\"AXUniqueId\":null,\"role\":\"AXGroup\",\"title\":null,\"frame\":{\"x\":0,\"y\":0,\"width\":401.99999999999994,\"height\":874},\"enabled\":true,\"custom_actions\":[],\"help\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXValue\":null,\"subrole\":null,\"content_required\":false,\"pid\":4295,\"role_description\":\"Group\",\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.33s]\r\n"]
[1.812, "m", "Deliver a notification while the app is not running"]
[1.812, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[1.993, "o", "[exited 0 after 0.18s]\r\n"]
[2.997, "m", "Tap the banner"]
[2.997, "o", "$ idb ui tap 201 90\r\n"]
[3.202, "o", "[exited 0 after 0.20s]\r\n"]
[3.832, "m", "Clear the app's delivered notifications"]
[3.832, "o", "$ idb notification clear com.apple.news\r\n"]
[4.234, "o", "[exited 0 after 0.40s]\r\n"]
[4.767, "m", "List notifications after clearing them"]
[4.767, "o", "$ idb notification list com.apple.news\r\n"]
[5.181, "o", "[exited 0 after 0.41s]\r\n"]
[6.377, "o", ""]
