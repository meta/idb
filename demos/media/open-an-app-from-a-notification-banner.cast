{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.248, "o", "[exited 0 after 0.25s]\r\n"]
[1.248, "m", "Go to the home screen"]
[1.248, "o", "$ idb ui button HOME\r\n"]
[1.428, "o", "[exited 0 after 0.18s]\r\n"]
[1.658, "m", "Check what is where the banner will appear"]
[1.658, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.982, "o", "{\"title\":null,\"role_description\":\"Group\",\"pid\":1288,\"AXLabel\":null,\"frame\":{\"width\":402,\"y\":0,\"x\":0,\"height\":874},\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"AXValue\":null,\"subrole\":null,\"type\":\"Group\",\"custom_actions\":[],\"AXUniqueId\":null,\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"enabled\":true,\"content_required\":false}\r\n[exited 0 after 0.32s]\r\n"]
[1.982, "m", "Deliver a notification while the app is not running"]
[1.982, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.172, "o", "[exited 0 after 0.19s]\r\n"]
[3.175, "m", "Tap the banner"]
[3.175, "o", "$ idb ui tap 201 90\r\n"]
[3.511, "o", "[exited 0 after 0.34s]\r\n"]
[4.338, "m", "Clear the app's delivered notifications"]
[4.338, "o", "$ idb notification clear com.apple.news\r\n"]
[4.836, "o", "[exited 0 after 0.50s]\r\n"]
[5.291, "m", "List notifications after clearing them"]
[5.291, "o", "$ idb notification list com.apple.news\r\n"]
[5.752, "o", "[exited 0 after 0.46s]\r\n"]
[7.383, "o", ""]
