{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.256, "o", "[exited 0 after 0.26s]\r\n"]
[1.257, "m", "Go to the home screen"]
[1.257, "o", "$ idb ui button HOME\r\n"]
[1.496, "o", "[exited 0 after 0.24s]\r\n"]
[1.758, "m", "Check what is where the banner will appear"]
[1.758, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.143, "o", "{\"custom_actions\":[],\"AXLabel\":null,\"type\":\"Group\",\"frame\":{\"x\":0,\"y\":0,\"width\":402.00000000000006,\"height\":874},\"AXValue\":null,\"pid\":1327,\"subrole\":null,\"traits\":[\"Scrollable\"],\"AXUniqueId\":null,\"role_description\":\"Group\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"title\":null,\"enabled\":true,\"content_required\":false,\"help\":null,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.38s]\r\n"]
[2.143, "m", "Deliver a notification while the app is not running"]
[2.143, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.389, "o", "[exited 0 after 0.25s]\r\n"]
[3.393, "m", "Tap the banner"]
[3.393, "o", "$ idb ui tap 201 90\r\n"]
[4.73, "o", "[exited 0 after 1.34s]\r\n"]
[9.853, "m", "Clear the app's delivered notifications"]
[9.853, "o", "$ idb notification clear com.apple.news\r\n"]
[10.498, "o", "[exited 0 after 0.64s]\r\n"]
[11.03, "m", "List notifications after clearing them"]
[11.03, "o", "$ idb notification list com.apple.news\r\n"]
[11.513, "o", "[exited 0 after 0.48s]\r\n"]
[12.405, "o", ""]
