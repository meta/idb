{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.271, "o", "[exited 0 after 0.27s]\r\n"]
[1.271, "m", "Go to the home screen"]
[1.271, "o", "$ idb ui button HOME\r\n"]
[1.458, "o", "[exited 0 after 0.19s]\r\n"]
[1.702, "m", "Check what is where the banner will appear"]
[1.702, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.032, "o", "{\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"type\":\"Group\",\"enabled\":true,\"role\":\"AXGroup\",\"traits\":[\"Scrollable\"],\"subrole\":null,\"content_required\":false,\"help\":null,\"AXLabel\":null,\"AXUniqueId\":null,\"AXValue\":null,\"role_description\":\"Group\",\"frame\":{\"x\":0,\"y\":0,\"height\":874,\"width\":402},\"title\":null,\"pid\":1306}\r\n[exited 0 after 0.33s]\r\n"]
[2.032, "m", "Deliver a notification while the app is not running"]
[2.032, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.228, "o", "[exited 0 after 0.20s]\r\n"]
[3.23, "m", "Tap the banner"]
[3.23, "o", "$ idb ui tap 201 90\r\n"]
[3.469, "o", "[exited 0 after 0.24s]\r\n"]
[4.217, "m", "Clear the app's delivered notifications"]
[4.217, "o", "$ idb notification clear com.apple.news\r\n"]
[4.684, "o", "[exited 0 after 0.47s]\r\n"]
[5.29, "m", "List notifications after clearing them"]
[5.29, "o", "$ idb notification list com.apple.news\r\n"]
[5.713, "o", "[exited 0 after 0.42s]\r\n"]
[7.007, "o", ""]
