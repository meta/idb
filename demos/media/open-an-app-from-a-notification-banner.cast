{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.222, "o", "[exited 0 after 0.22s]\r\n"]
[1.222, "m", "Go to the home screen"]
[1.222, "o", "$ idb ui button HOME\r\n"]
[1.403, "o", "[exited 0 after 0.18s]\r\n"]
[1.644, "m", "Check what is where the banner will appear"]
[1.644, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.995, "o", "{\"custom_actions\":[],\"subrole\":null,\"pid\":1289,\"AXValue\":null,\"AXUniqueId\":null,\"content_required\":false,\"type\":\"Group\",\"title\":null,\"enabled\":true,\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"help\":null,\"role_description\":\"Group\",\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"frame\":{\"y\":0,\"width\":402.00000000000006,\"height\":874,\"x\":0}}\r\n[exited 0 after 0.35s]\r\n"]
[1.995, "m", "Deliver a notification while the app is not running"]
[1.995, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.232, "o", "[exited 0 after 0.24s]\r\n"]
[3.235, "m", "Tap the banner"]
[3.235, "o", "$ idb ui tap 201 90\r\n"]
[3.58, "o", "[exited 0 after 0.34s]\r\n"]
[4.812, "m", "Clear the app's delivered notifications"]
[4.812, "o", "$ idb notification clear com.apple.news\r\n"]
[5.357, "o", "[exited 0 after 0.54s]\r\n"]
[5.888, "m", "List notifications after clearing them"]
[5.888, "o", "$ idb notification list com.apple.news\r\n"]
[7.01, "o", "[exited 0 after 1.12s]\r\n"]
[8.303, "o", ""]
