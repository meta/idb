{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.242, "o", "[exited 0 after 0.24s]\r\n"]
[1.242, "m", "Go to the home screen"]
[1.242, "o", "$ idb ui button HOME\r\n"]
[1.424, "o", "[exited 0 after 0.18s]\r\n"]
[1.631, "m", "Check what is where the banner will appear"]
[1.631, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[1.934, "o", "{\"frame\":{\"y\":0,\"height\":874,\"x\":0,\"width\":401.99999999999994},\"custom_actions\":[],\"title\":null,\"AXLabel\":null,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"AXUniqueId\":null,\"traits\":[\"Scrollable\"],\"help\":null,\"content_required\":false,\"pid\":1284,\"enabled\":true,\"role\":\"AXGroup\",\"AXValue\":null,\"type\":\"Group\",\"subrole\":null,\"role_description\":\"Group\"}\r\n[exited 0 after 0.30s]\r\n"]
[1.934, "m", "Deliver a notification while the app is not running"]
[1.934, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.152, "o", "[exited 0 after 0.22s]\r\n"]
[3.154, "m", "Tap the banner"]
[3.154, "o", "$ idb ui tap 201 90\r\n"]
[3.4, "o", "[exited 0 after 0.25s]\r\n"]
[4.2, "m", "Clear the app's delivered notifications"]
[4.2, "o", "$ idb notification clear com.apple.news\r\n"]
[4.689, "o", "[exited 0 after 0.49s]\r\n"]
[5.152, "m", "List notifications after clearing them"]
[5.152, "o", "$ idb notification list com.apple.news\r\n"]
[5.576, "o", "[exited 0 after 0.42s]\r\n"]
[7.04, "o", ""]
