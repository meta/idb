{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.269, "o", "[exited 0 after 0.27s]\r\n"]
[1.269, "m", "Go to the home screen"]
[1.269, "o", "$ idb ui button HOME\r\n"]
[1.465, "o", "[exited 0 after 0.20s]\r\n"]
[1.712, "m", "Check what is where the banner will appear"]
[1.712, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.139, "o", "{\"type\":\"Group\",\"frame\":{\"width\":401.99999999999994,\"y\":0,\"x\":0,\"height\":874},\"custom_actions\":[],\"enabled\":true,\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"pid\":1952,\"AXValue\":null,\"content_required\":false,\"role\":\"AXGroup\",\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"title\":null,\"AXUniqueId\":null,\"subrole\":null,\"help\":null}\r\n[exited 0 after 0.43s]\r\n"]
[2.139, "m", "Deliver a notification while the app is not running"]
[2.139, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.344, "o", "[exited 0 after 0.20s]\r\n"]
[3.349, "m", "Tap the banner"]
[3.349, "o", "$ idb ui tap 201 90\r\n"]
[3.687, "o", "[exited 0 after 0.34s]\r\n"]
[4.702, "m", "Clear the app's delivered notifications"]
[4.702, "o", "$ idb notification clear com.apple.news\r\n"]
[5.308, "o", "[exited 0 after 0.61s]\r\n"]
[5.885, "m", "List notifications after clearing them"]
[5.885, "o", "$ idb notification list com.apple.news\r\n"]
[6.354, "o", "[exited 0 after 0.47s]\r\n"]
[7.947, "o", ""]
