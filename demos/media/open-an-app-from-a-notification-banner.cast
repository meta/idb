{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.272, "o", "[exited 0 after 0.27s]\r\n"]
[1.273, "m", "Go to the home screen"]
[1.273, "o", "$ idb ui button HOME\r\n"]
[1.485, "o", "[exited 0 after 0.21s]\r\n"]
[2.2, "m", "Check what is where the banner will appear"]
[2.2, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.5, "o", "{\"help\":null,\"AXLabel\":null,\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role_description\":\"Group\",\"custom_actions\":[],\"AXValue\":null,\"subrole\":null,\"AXUniqueId\":null,\"content_required\":false,\"traits\":[\"Scrollable\"],\"role\":\"AXGroup\",\"pid\":1372,\"frame\":{\"y\":0,\"height\":874,\"width\":402.00000000000006,\"x\":0},\"title\":null,\"type\":\"Group\"}\r\n[exited 0 after 0.30s]\r\n"]
[2.501, "m", "Deliver a notification while the app is not running"]
[2.501, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.763, "o", "[exited 0 after 0.26s]\r\n"]
[3.765, "m", "Tap the banner"]
[3.765, "o", "$ idb ui tap 201 90\r\n"]
[4.003, "o", "[exited 0 after 0.24s]\r\n"]
[5.22, "m", "Clear the app's delivered notifications"]
[5.22, "o", "$ idb notification clear com.apple.news\r\n"]
[5.752, "o", "[exited 0 after 0.53s]\r\n"]
[6.318, "m", "List notifications after clearing them"]
[6.318, "o", "$ idb notification list com.apple.news\r\n"]
[6.759, "o", "[exited 0 after 0.44s]\r\n"]
[8.457, "o", ""]
