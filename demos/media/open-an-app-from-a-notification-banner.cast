{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.264, "o", "[exited 0 after 0.26s]\r\n"]
[1.265, "m", "Go to the home screen"]
[1.265, "o", "$ idb ui button HOME\r\n"]
[1.448, "o", "[exited 0 after 0.18s]\r\n"]
[1.678, "m", "Check what is where the banner will appear"]
[1.678, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.086, "o", "{\"content_required\":false,\"title\":null,\"help\":null,\"pid\":7182,\"AXValue\":null,\"AXUniqueId\":null,\"frame\":{\"x\":0,\"height\":874,\"y\":0,\"width\":402.00000000000006},\"AXLabel\":null,\"traits\":[\"Scrollable\"],\"custom_actions\":[],\"type\":\"Group\",\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"enabled\":true,\"subrole\":null,\"role_description\":\"Group\"}\r\n[exited 0 after 0.41s]\r\n"]
[2.087, "m", "Deliver a notification while the app is not running"]
[2.087, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.338, "o", "[exited 0 after 0.25s]\r\n"]
[3.342, "m", "Tap the banner"]
[3.342, "o", "$ idb ui tap 201 90\r\n"]
[3.618, "o", "[exited 0 after 0.28s]\r\n"]
[4.504, "m", "Clear the app's delivered notifications"]
[4.504, "o", "$ idb notification clear com.apple.news\r\n"]
[4.986, "o", "[exited 0 after 0.48s]\r\n"]
[5.636, "m", "List notifications after clearing them"]
[5.636, "o", "$ idb notification list com.apple.news\r\n"]
[6.107, "o", "[exited 0 after 0.47s]\r\n"]
[7.698, "o", ""]
