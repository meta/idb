{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.285, "o", "[exited 0 after 0.29s]\r\n"]
[1.286, "m", "Go to the home screen"]
[1.286, "o", "$ idb ui button HOME\r\n"]
[1.489, "o", "[exited 0 after 0.20s]\r\n"]
[1.755, "m", "Check what is where the banner will appear"]
[1.755, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.235, "o", "{\"type\":\"Group\",\"role_description\":\"Group\",\"AXUniqueId\":null,\"AXValue\":null,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"traits\":[\"Scrollable\"],\"subrole\":null,\"pid\":1280,\"content_required\":false,\"custom_actions\":[],\"enabled\":true,\"title\":null,\"AXLabel\":null,\"frame\":{\"y\":0,\"width\":401.99999999999994,\"x\":0,\"height\":874},\"help\":null}\r\n[exited 0 after 0.48s]\r\n"]
[2.235, "m", "Deliver a notification while the app is not running"]
[2.235, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.492, "o", "[exited 0 after 0.26s]\r\n"]
[3.496, "m", "Tap the banner"]
[3.496, "o", "$ idb ui tap 201 90\r\n"]
[3.76, "o", "[exited 0 after 0.26s]\r\n"]
[4.462, "m", "Clear the app's delivered notifications"]
[4.462, "o", "$ idb notification clear com.apple.news\r\n"]
[5.009, "o", "[exited 0 after 0.55s]\r\n"]
[5.631, "m", "List notifications after clearing them"]
[5.631, "o", "$ idb notification list com.apple.news\r\n"]
[6.244, "o", "[exited 0 after 0.61s]\r\n"]
[8.498, "o", ""]
