{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.292, "o", "[exited 0 after 0.29s]\r\n"]
[1.292, "m", "Go to the home screen"]
[1.292, "o", "$ idb ui button HOME\r\n"]
[1.496, "o", "[exited 0 after 0.20s]\r\n"]
[1.722, "m", "Check what is where the banner will appear"]
[1.722, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.043, "o", "{\"frame\":{\"y\":0,\"height\":874,\"width\":402,\"x\":0},\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"custom_actions\":[],\"AXLabel\":null,\"subrole\":null,\"role_description\":\"Group\",\"role\":\"AXGroup\",\"AXUniqueId\":null,\"title\":null,\"type\":\"Group\",\"AXValue\":null,\"help\":null,\"content_required\":false,\"pid\":1361,\"traits\":[\"Scrollable\"]}\r\n[exited 0 after 0.32s]\r\n"]
[2.051, "m", "Deliver a notification while the app is not running"]
[2.051, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.266, "o", "[exited 0 after 0.21s]\r\n"]
[3.268, "m", "Tap the banner"]
[3.268, "o", "$ idb ui tap 201 90\r\n"]
[3.493, "o", "[exited 0 after 0.23s]\r\n"]
[4.239, "m", "Clear the app's delivered notifications"]
[4.239, "o", "$ idb notification clear com.apple.news\r\n"]
[4.718, "o", "[exited 0 after 0.48s]\r\n"]
[5.218, "m", "List notifications after clearing them"]
[5.218, "o", "$ idb notification list com.apple.news\r\n"]
[5.648, "o", "[exited 0 after 0.43s]\r\n"]
[7.222, "o", ""]
