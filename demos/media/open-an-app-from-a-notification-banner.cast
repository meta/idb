{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.24, "o", "[exited 0 after 0.24s]\r\n"]
[1.24, "m", "Go to the home screen"]
[1.24, "o", "$ idb ui button HOME\r\n"]
[1.438, "o", "[exited 0 after 0.20s]\r\n"]
[1.676, "m", "Check what is where the banner will appear"]
[1.676, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.271, "o", "{\"pid\":1341,\"type\":\"Group\",\"AXUniqueId\":null,\"role\":\"AXGroup\",\"frame\":{\"width\":401.99999999999994,\"height\":874,\"y\":0,\"x\":0},\"role_description\":\"Group\",\"traits\":[\"Scrollable\"],\"content_required\":false,\"help\":null,\"AXValue\":null,\"enabled\":true,\"custom_actions\":[],\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"title\":null,\"subrole\":null,\"AXLabel\":null}\r\n[exited 0 after 0.60s]\r\n"]
[2.272, "m", "Deliver a notification while the app is not running"]
[2.272, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.583, "o", "[exited 0 after 0.31s]\r\n"]
[3.586, "m", "Tap the banner"]
[3.586, "o", "$ idb ui tap 201 90\r\n"]
[3.827, "o", "[exited 0 after 0.24s]\r\n"]
[4.703, "m", "Clear the app's delivered notifications"]
[4.703, "o", "$ idb notification clear com.apple.news\r\n"]
[5.369, "o", "[exited 0 after 0.67s]\r\n"]
[5.99, "m", "List notifications after clearing them"]
[5.99, "o", "$ idb notification list com.apple.news\r\n"]
[6.547, "o", "[exited 0 after 0.56s]\r\n"]
[8.59, "o", ""]
