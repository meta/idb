{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.22, "o", "[exited 0 after 0.22s]\r\n"]
[1.22, "m", "Go to the home screen"]
[1.22, "o", "$ idb ui button HOME\r\n"]
[1.423, "o", "[exited 0 after 0.20s]\r\n"]
[1.669, "m", "Check what is where the banner will appear"]
[1.669, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.056, "o", "{\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"AXLabel\":null,\"pid\":1282,\"custom_actions\":[],\"enabled\":true,\"AXValue\":null,\"role_description\":\"Group\",\"AXUniqueId\":null,\"frame\":{\"width\":402.00000000000006,\"height\":874,\"y\":0,\"x\":0},\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"help\":null,\"role\":\"AXGroup\",\"subrole\":null,\"title\":null,\"content_required\":false}\r\n[exited 0 after 0.39s]\r\n"]
[2.057, "m", "Deliver a notification while the app is not running"]
[2.057, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.275, "o", "[exited 0 after 0.22s]\r\n"]
[3.278, "m", "Tap the banner"]
[3.278, "o", "$ idb ui tap 201 90\r\n"]
[3.569, "o", "[exited 0 after 0.29s]\r\n"]
[4.404, "m", "Clear the app's delivered notifications"]
[4.404, "o", "$ idb notification clear com.apple.news\r\n"]
[5.0, "o", "[exited 0 after 0.60s]\r\n"]
[5.58, "m", "List notifications after clearing them"]
[5.58, "o", "$ idb notification list com.apple.news\r\n"]
[6.095, "o", "[exited 0 after 0.52s]\r\n"]
[7.332, "o", ""]
