{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.313, "o", "[exited 0 after 0.31s]\r\n"]
[1.314, "m", "Go to the home screen"]
[1.314, "o", "$ idb ui button HOME\r\n"]
[1.516, "o", "[exited 0 after 0.20s]\r\n"]
[1.756, "m", "Check what is where the banner will appear"]
[1.756, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.105, "o", "{\"pid\":1358,\"frame\":{\"x\":0,\"width\":401.99999999999994,\"y\":0,\"height\":874},\"title\":null,\"type\":\"Group\",\"subrole\":null,\"content_required\":false,\"traits\":[\"Scrollable\"],\"AXValue\":null,\"help\":null,\"AXLabel\":null,\"AXUniqueId\":null,\"role_description\":\"Group\",\"custom_actions\":[],\"enabled\":true,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\"}\r\n[exited 0 after 0.35s]\r\n"]
[2.106, "m", "Deliver a notification while the app is not running"]
[2.106, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.401, "o", "[exited 0 after 0.30s]\r\n"]
[3.404, "m", "Tap the banner"]
[3.404, "o", "$ idb ui tap 201 90\r\n"]
[4.026, "o", "[exited 0 after 0.62s]\r\n"]
[4.554, "m", "Clear the app's delivered notifications"]
[4.554, "o", "$ idb notification clear com.apple.news\r\n"]
[5.09, "o", "[exited 0 after 0.54s]\r\n"]
[5.77, "m", "List notifications after clearing them"]
[5.77, "o", "$ idb notification list com.apple.news\r\n"]
[6.311, "o", "[exited 0 after 0.54s]\r\n"]
[7.547, "o", ""]
