{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.268, "o", "[exited 0 after 0.27s]\r\n"]
[1.268, "m", "Go to the home screen"]
[1.268, "o", "$ idb ui button HOME\r\n"]
[1.593, "o", "[exited 0 after 0.33s]\r\n"]
[2.212, "m", "Check what is where the banner will appear"]
[2.212, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.439, "o", "{\"custom_actions\":[],\"title\":null,\"subrole\":null,\"AXLabel\":null,\"pid\":2286,\"help\":null,\"AXFrame\":\"{{0, 0}, {402, 874}}\",\"AXUniqueId\":null,\"role_description\":\"Group\",\"type\":\"Group\",\"traits\":[\"Scrollable\"],\"frame\":{\"x\":0,\"width\":402,\"y\":0,\"height\":874},\"AXValue\":null,\"enabled\":true,\"content_required\":false,\"role\":\"AXGroup\"}\r\n[exited 0 after 0.23s]\r\n"]
[2.439, "m", "Deliver a notification while the app is not running"]
[2.439, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.788, "o", "[exited 0 after 0.35s]\r\n"]
[3.79, "m", "Tap the banner"]
[3.79, "o", "$ idb ui tap 201 90\r\n"]
[4.025, "o", "[exited 0 after 0.24s]\r\n"]
[5.098, "m", "Clear the app's delivered notifications"]
[5.098, "o", "$ idb notification clear com.apple.news\r\n"]
[5.549, "o", "[exited 0 after 0.45s]\r\n"]
[5.991, "m", "List notifications after clearing them"]
[5.991, "o", "$ idb notification list com.apple.news\r\n"]
[6.432, "o", "[exited 0 after 0.44s]\r\n"]
[8.045, "o", ""]
