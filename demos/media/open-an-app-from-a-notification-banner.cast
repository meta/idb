{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.24, "o", "[exited 0 after 0.24s]\r\n"]
[1.241, "m", "Go to the home screen"]
[1.241, "o", "$ idb ui button HOME\r\n"]
[1.442, "o", "[exited 0 after 0.20s]\r\n"]
[1.673, "m", "Check what is where the banner will appear"]
[1.673, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.046, "o", "{\"AXUniqueId\":null,\"role_description\":\"Group\",\"AXValue\":null,\"pid\":1335,\"help\":null,\"AXLabel\":null,\"content_required\":false,\"title\":null,\"role\":\"AXGroup\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"subrole\":null,\"traits\":[\"Scrollable\"],\"type\":\"Group\",\"frame\":{\"x\":0,\"width\":401.99999999999994,\"height\":874,\"y\":0},\"enabled\":true,\"custom_actions\":[]}\r\n[exited 0 after 0.37s]\r\n"]
[2.047, "m", "Deliver a notification while the app is not running"]
[2.047, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.242, "o", "[exited 0 after 0.20s]\r\n"]
[3.245, "m", "Tap the banner"]
[3.245, "o", "$ idb ui tap 201 90\r\n"]
[3.517, "o", "[exited 0 after 0.27s]\r\n"]
[4.288, "m", "Clear the app's delivered notifications"]
[4.288, "o", "$ idb notification clear com.apple.news\r\n"]
[4.756, "o", "[exited 0 after 0.47s]\r\n"]
[5.372, "m", "List notifications after clearing them"]
[5.372, "o", "$ idb notification list com.apple.news\r\n"]
[5.889, "o", "[exited 0 after 0.52s]\r\n"]
[7.715, "o", ""]
