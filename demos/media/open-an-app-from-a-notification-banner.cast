{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.24, "o", "[exited 0 after 0.24s]\r\n"]
[1.241, "m", "Go to the home screen"]
[1.241, "o", "$ idb ui button HOME\r\n"]
[1.422, "o", "[exited 0 after 0.18s]\r\n"]
[1.647, "m", "Check what is where the banner will appear"]
[1.647, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.001, "o", "{\"role\":\"AXGroup\",\"help\":null,\"AXUniqueId\":null,\"pid\":1279,\"enabled\":true,\"AXLabel\":null,\"AXValue\":null,\"content_required\":false,\"role_description\":\"Group\",\"frame\":{\"x\":0,\"y\":0,\"width\":401.99999999999994,\"height\":874},\"custom_actions\":[],\"traits\":[\"Scrollable\"],\"title\":null,\"type\":\"Group\",\"AXFrame\":\"{{0, 0}, {401.99999999999994, 874}}\",\"subrole\":null}\r\n[exited 0 after 0.35s]\r\n"]
[2.001, "m", "Deliver a notification while the app is not running"]
[2.001, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.278, "o", "[exited 0 after 0.28s]\r\n"]
[3.281, "m", "Tap the banner"]
[3.281, "o", "$ idb ui tap 201 90\r\n"]
[4.156, "o", "[exited 0 after 0.88s]\r\n"]
[4.959, "m", "Clear the app's delivered notifications"]
[4.959, "o", "$ idb notification clear com.apple.news\r\n"]
[5.664, "o", "[exited 0 after 0.70s]\r\n"]
[6.222, "m", "List notifications after clearing them"]
[6.222, "o", "$ idb notification list com.apple.news\r\n"]
[7.004, "o", "[exited 0 after 0.78s]\r\n"]
[8.69, "o", ""]
