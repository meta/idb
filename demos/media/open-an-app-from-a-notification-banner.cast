{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.265, "o", "[exited 0 after 0.26s]\r\n"]
[1.265, "m", "Go to the home screen"]
[1.265, "o", "$ idb ui button HOME\r\n"]
[1.454, "o", "[exited 0 after 0.19s]\r\n"]
[1.693, "m", "Check what is where the banner will appear"]
[1.693, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.094, "o", "{\"subrole\":null,\"help\":null,\"AXLabel\":null,\"frame\":{\"x\":0,\"width\":402.00000000000006,\"y\":0,\"height\":874},\"enabled\":true,\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"pid\":1406,\"content_required\":false,\"AXUniqueId\":null,\"traits\":[\"Scrollable\"],\"role_description\":\"Group\",\"role\":\"AXGroup\",\"type\":\"Group\",\"custom_actions\":[],\"title\":null,\"AXValue\":null}\r\n[exited 0 after 0.40s]\r\n"]
[2.094, "m", "Deliver a notification while the app is not running"]
[2.094, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.408, "o", "[exited 0 after 0.31s]\r\n"]
[3.41, "m", "Tap the banner"]
[3.41, "o", "$ idb ui tap 201 90\r\n"]
[3.818, "o", "[exited 0 after 0.41s]\r\n"]
[4.862, "m", "Clear the app's delivered notifications"]
[4.862, "o", "$ idb notification clear com.apple.news\r\n"]
[5.435, "o", "[exited 0 after 0.57s]\r\n"]
[6.077, "m", "List notifications after clearing them"]
[6.077, "o", "$ idb notification list com.apple.news\r\n"]
[6.631, "o", "[exited 0 after 0.55s]\r\n"]
[8.572, "o", ""]
