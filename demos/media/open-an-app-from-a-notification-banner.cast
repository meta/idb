{"env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "height": 24, "title": "Deliver a push notification and open the app from its banner", "version": 2, "width": 80}
[1.0, "m", "Grant notification permission without showing a prompt"]
[1.0, "o", "$ idb approve com.apple.news notification\r\n"]
[1.253, "o", "[exited 0 after 0.25s]\r\n"]
[1.253, "m", "Go to the home screen"]
[1.253, "o", "$ idb ui button HOME\r\n"]
[1.439, "o", "[exited 0 after 0.19s]\r\n"]
[1.67, "m", "Check what is where the banner will appear"]
[1.67, "o", "$ idb ui describe-point 201 90 --json\r\n"]
[2.058, "o", "{\"AXFrame\":\"{{0, 0}, {402.00000000000006, 874}}\",\"role\":\"AXGroup\",\"pid\":1270,\"frame\":{\"height\":874,\"y\":0,\"x\":0,\"width\":402.00000000000006},\"AXUniqueId\":null,\"content_required\":false,\"help\":null,\"role_description\":\"Group\",\"custom_actions\":[],\"AXLabel\":null,\"AXValue\":null,\"type\":\"Group\",\"enabled\":true,\"subrole\":null,\"traits\":[\"Scrollable\"],\"title\":null}\r\n[exited 0 after 0.39s]\r\n"]
[2.058, "m", "Deliver a notification while the app is not running"]
[2.058, "o", "$ idb send-notification com.apple.news '{\"aps\": {\"alert\": {\"title\": \"Breaking\", \"body\": \"idb delivered this without the app running.\"}}}'\r\n"]
[2.263, "o", "[exited 0 after 0.21s]\r\n"]
[3.267, "m", "Tap the banner"]
[3.267, "o", "$ idb ui tap 201 90\r\n"]
[3.647, "o", "[exited 0 after 0.38s]\r\n"]
[4.463, "m", "Clear the app's delivered notifications"]
[4.463, "o", "$ idb notification clear com.apple.news\r\n"]
[5.02, "o", "[exited 0 after 0.56s]\r\n"]
[5.662, "m", "List notifications after clearing them"]
[5.662, "o", "$ idb notification list com.apple.news\r\n"]
[6.184, "o", "[exited 0 after 0.52s]\r\n"]
[8.022, "o", ""]
